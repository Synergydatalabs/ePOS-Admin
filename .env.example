# Aurora Postgres — shared with tap-app.
DATABASE_URL="postgresql://user:pass@host:5432/itap_pos_dev?schema=public"

# JWT secret for the admin_token cookie. 32+ char random string.
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"

# S3 bucket reuse (tap-app image bucket) for any admin-uploaded assets.
S3_BUCKET_NAME="tapapp-images-prod"
AWS_REGION="us-east-1"
