// iTAP POS - Complete Database Schema
// Database: itap_pos_dev
// Uses same AWS RDS cluster but separate database
//
// UI Access Levels:
// - TENANT_OWNER: Full admin portal access (setup, reports, billing)
// - POS_ADMIN: Admin portal (setup, reports) + Counter POS
// - POS_MANAGER: Limited admin (view reports) + Counter POS + Kitchen
// - POS_STAFF: Counter POS only
// - KITCHEN_STAFF: Kitchen Display only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SECTION 1: TENANT & ORGANIZATION
// ============================================

model Tenant {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @db.VarChar(255)
  slug         String       @unique @db.VarChar(100)
  status       TenantStatus @default(ACTIVE)
  currency     String       @default("CAD") @db.VarChar(3)
  timezone     String       @default("America/Toronto") @db.VarChar(50)
  logoUrl      String?      @map("logo_url") @db.VarChar(500)
  authProvider String       @default("cognito") @map("auth_provider") @db.VarChar(20)
  businessType String       @default("restaurant") @map("business_type") @db.VarChar(20)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Phase 5d (2026-05-18): per-tenant BYO Meta WhatsApp credentials
  // (token-shaped fields encrypted at rest; phone_number_id stays plaintext
  // for inbound-webhook reverse lookup)
  metaPhoneNumberId         String?   @map("meta_phone_number_id") @db.VarChar(64)
  metaWabaId                String?   @map("meta_waba_id") @db.VarChar(64)
  metaAccessTokenEnc        String?   @map("meta_access_token_enc")
  metaAppSecretEnc          String?   @map("meta_app_secret_enc")
  metaWebhookVerifyTokenEnc String?   @map("meta_webhook_verify_token_enc")
  metaDisplayName           String?   @map("meta_display_name") @db.VarChar(255)
  metaConnectionType        String?   @map("meta_connection_type") @db.VarChar(20)
  metaConnectedAt           DateTime? @map("meta_connected_at")
  metaLastHealthCheckAt     DateTime? @map("meta_last_health_check_at")
  metaHealthStatus          String?   @map("meta_health_status") @db.VarChar(20)

  // Phase 6 (2026-05-18): public booking page top-level toggle
  publicBookingEnabled Boolean @default(true) @map("public_booking_enabled")
  bookingTagline       String? @map("booking_tagline") @db.VarChar(200)

  // Relations
  locations              Location[]
  memberships            Membership[]
  subscriptions          Subscription[]
  settings               TenantSettings?
  billingInvoices        BillingInvoice[]
  categories             Category[]
  products               Product[]
  modifierGroups         ModifierGroup[]
  ingredients            Ingredient[]
  suppliers              Supplier[]
  unitsOfMeasure         UnitOfMeasure[]
  upsellRules            UpsellRule[]
  smartPrompts           SmartPrompt[]
  promotions             Promotion[]
  loyaltyProgram         LoyaltyProgram?
  kitchenLoadRules       KitchenLoadRule[]
  // Phase 1 (2026-05-18): guest CRM + S3 uploads
  guestProfiles          GuestProfile[]
  uploadedFiles          UploadedFile[]
  // Phase 5d (2026-05-18): inbound conversation inbox
  conversationMessages   ConversationMessage[]
  // Gift cards issued under this tenant
  giftCards              GiftCard[]
  cashDrawerSessions     CashDrawerSession[]
  timeClockEntries       TimeClockEntry[]
  taxCategories          TaxCategory[]
  tipPools               TipPool[]
  integrationConnections IntegrationConnection[]

  // Phase 8 (2026-07-30): supplier marketplace.
  //
  // A Tenant with businessType='supplier' has a one-to-one SupplierProfile
  // holding the marketplace-specific fields (warehouse, categories, min order,
  // etc.). Merchant tenants never have this row. See SupplierProfile below.
  supplierProfile         SupplierProfile?
  // Invites this tenant SENT (merchant side). Only merchant tenants use this.
  supplierInvitesSent     SupplierInvite[]               @relation("SupplierInvitesFromMerchant")
  // Relationships where this tenant is the SUPPLIER — accepted by merchants.
  asSupplierRelationships SupplierMerchantRelationship[] @relation("RelationshipSupplierSide")
  // Relationships where this tenant is the MERCHANT — with suppliers we buy from.
  asMerchantRelationships SupplierMerchantRelationship[] @relation("RelationshipMerchantSide")
  // Local Supplier rows (inventory reference records on other tenants) that
  // point to THIS supplier tenant once they've accepted an invite. Back-ref
  // for Supplier.linkedTenantId — lets us find "who has me in their supplier
  // list" from the supplier's side.
  linkedFromSuppliers     Supplier[]                     @relation("SupplierLinkedTenant")
  // Phase D #77 (2026-07-31): merchant Ingredients that name this tenant
  // as their preferred marketplace supplier for auto-reorder. Only
  // populated for supplier-tenants; merchant tenants keep this empty.
  preferredForIngredients Ingredient[]                   @relation("IngredientPreferredSupplier")

  // Phase B (2026-07-30): supplier catalog. Only populated for tenants with
  // businessType='supplier'; merchant tenants keep these arrays empty.
  supplierProductCategories SupplierProductCategory[]
  supplierProducts          SupplierProduct[]
  // Phase D #76 (2026-07-31): supplier fulfillment warehouses. Only
  // populated for supplier tenants; single-location suppliers just have
  // one row.
  supplierWarehouses        SupplierWarehouse[]       @relation("SupplierWarehouses")

  // Purchase orders — two sides. As SUPPLIER = orders received (fulfilled);
  // as MERCHANT = orders sent (placed). Named relations because both point
  // at the same Tenant table.
  purchaseOrdersAsSupplier PurchaseOrder[] @relation("PurchaseOrderSupplier")
  purchaseOrdersAsMerchant PurchaseOrder[] @relation("PurchaseOrderMerchant")

  // Phase C (2026-07-30) / Phase 2b (2026-08): payment-gateway onboarding +
  // active processor credentials. Populated for MERCHANT tenants (POS card
  // acceptance) AND SUPPLIER tenants (marketplace payments). The tenantRole
  // column on MerchantApplication distinguishes the two.
  merchantApplications   MerchantApplication[]
  tenantPaymentProviders TenantPaymentProvider[]

  // Phase I #4 (2026-09-11): tenant approval flow. Mirrors tap-app.
  // Admin app reads verification to render the pending-review queue and
  // uses adminReviewerEmail + adminDecision to record approvals.
  verification       TenantVerification?
  verificationTokens TenantVerificationToken[]

  @@index([metaPhoneNumberId], map: "idx_tenants_meta_phone_number_id")
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  // Phase I #4 (2026-09-11): mirrors tap-app enum. New signups land here.
  PENDING_APPROVAL
  REJECTED
}

// Phase I #4 (2026-09-11): tenant approval flow — mirrors tap-app.
// Admin app reads this to render the pending-review queue and writes
// admin_decision + rejection_reason on approve/reject.
model TenantVerification {
  tenantId             String    @id @map("tenant_id") @db.Uuid
  contactEmail         String    @map("contact_email") @db.VarChar(255)
  contactPhone         String?   @map("contact_phone") @db.VarChar(40)
  emailVerifiedAt      DateTime? @map("email_verified_at")
  phoneVerifiedAt      DateTime? @map("phone_verified_at")
  adminReviewedAt      DateTime? @map("admin_reviewed_at")
  adminReviewerEmail   String?   @map("admin_reviewer_email") @db.VarChar(255)
  adminDecision        String?   @map("admin_decision") @db.VarChar(20)
  adminNotes           String?   @map("admin_notes") @db.Text
  rejectionReason      String?   @map("rejection_reason") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_verifications")
}

// Phase I #4 (2026-09-11): OTP token log — mirrors tap-app. Admin app
// does not create rows (all OTP flow is applicant-side in tap-app) but
// we model it here so support can query "which codes have we sent this
// tenant" for troubleshooting a stuck signup.
model TenantVerificationToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  channel       String    @db.VarChar(20)
  transport     String?   @db.VarChar(20)
  destination   String    @db.VarChar(255)
  code          String    @db.VarChar(10)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  attemptsLeft  Int       @default(5) @map("attempts_left")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, createdAt(sort: Desc)])
  @@map("tenant_verification_tokens")
}

model Location {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  name           String         @db.VarChar(255)
  address        String?        @db.VarChar(500)
  city           String?        @db.VarChar(100)
  province       String?        @db.VarChar(100)
  postalCode     String?        @map("postal_code") @db.VarChar(20)
  country        String         @default("CA") @db.VarChar(2)
  phone          String?        @db.VarChar(20)
  status         LocationStatus @default(ACTIVE)
  isDefault      Boolean        @default(false) @map("is_default")
  // Phase 3c (2026-05-18): public slug for embeddable virtual tour URL
  // — /tour/<slug> works without auth, used by customer-facing booking
  publicTourSlug String         @unique @map("public_tour_slug") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables                   Table[]
  kitchenStations          KitchenStation[]
  locationInventory        LocationInventory[]
  orders                   Order[]
  stockMovements           StockMovement[]
  tableSessions            TableSession[]
  kitchenLoadRule          KitchenLoadRule?
  staffNotifications       StaffNotification[]
  terminals                Terminal[]
  // Phase 1 (2026-05-18): floor plan + reservations
  floorPlans               FloorPlan[]
  reservations             Reservation[]
  waitlistEntries          WaitlistEntry[]
  sectionTemplates         SectionTemplate[]
  serverSectionAssignments ServerSectionAssignment[]
  specialDates             SpecialDate[]
  guestArrivalEvents       GuestArrivalEvent[]
  // Phase 3b (2026-05-18): restaurant media gallery (per-location)
  mediaItems               MediaItem[] // located here on Location since MediaItem.locationId points here

  // Phase 6 (2026-05-18): public customer booking page
  publicBookingEnabled Boolean @default(true) @map("public_booking_enabled")
  publicBookingSlug    String? @map("public_booking_slug") @db.VarChar(100)
  operatingHours       Json?   @map("operating_hours")
  bookingLeadMinutes   Int     @default(60) @map("booking_lead_minutes")
  bookingSlotMinutes   Int     @default(30) @map("booking_slot_minutes")
  bookingMaxPartySize  Int     @default(12) @map("booking_max_party_size")
  bookingHeroMediaId   String? @map("booking_hero_media_id") @db.Uuid

  // Phase 5d (2026-05-18): inbound conversation inbox (per-location optional)
  conversationMessages ConversationMessage[]
  cashDrawerSessions   CashDrawerSession[]
  timeClockEntries     TimeClockEntry[]      @relation("TimeClockLocation")
  taxRateOverrides     LocationTaxRate[]
  tipPools             TipPool[]             @relation("TipPoolLocation")

  // Phase B (2026-07-30): purchase orders shipped to this location.
  // A merchant may have multiple locations and order to a specific one.
  purchaseOrdersShippedTo PurchaseOrder[] @relation("PurchaseOrderShippingLocation")

  @@unique([tenantId, publicBookingSlug], map: "uniq_locations_tenant_booking_slug")
  @@index([tenantId])
  @@map("locations")
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

// ============================================
// SECTION 2: MEMBERSHIP & RBAC
// ============================================

model Membership {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  userSub   String       @map("user_sub") @db.VarChar(255) // Cognito sub OR 'local-{email}' for POS staff
  email     String       @db.VarChar(255)
  firstName String?      @map("first_name") @db.VarChar(100)
  lastName  String?      @map("last_name") @db.VarChar(100)
  role      MemberRole   @default(POS_STAFF)
  status    MemberStatus @default(PENDING)
  pin       String?      @db.VarChar(10) // Quick login PIN for POS

  // Phase 4 (2026-05-18): per-server color for floor view visual identification
  color String? @db.VarChar(7) // hex like '#3B82F6'

  // Local POS Authentication (for staff without Cognito accounts)
  passwordHash       String?   @map("password_hash") @db.VarChar(255) // bcrypt hashed password
  mustChangePassword Boolean   @default(true) @map("must_change_password") // Force password change on first login
  lastPasswordChange DateTime? @map("last_password_change")
  loginAttempts      Int       @default(0) @map("login_attempts") // For rate limiting
  lockedUntil        DateTime? @map("locked_until") // Account lockout after failed attempts

  // Password reset (for partner DB auth)
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Salon/Technician fields
  specialties    String[] @default([]) // Array of product IDs this technician can perform
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2) // Percentage commission per service

  invitedBy    String?   @map("invited_by") @db.Uuid
  invitedAt    DateTime? @map("invited_at")
  activatedAt  DateTime? @map("activated_at")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordersCreated            Order[]                   @relation("CreatedByMember")
  stockMovements           StockMovement[]           @relation("StockMovementBy")
  kitchenQueueUpdates      KitchenQueue[]            @relation("KitchenUpdatedBy")
  assignedServices         OrderItem[]               @relation("TechnicianAssignments")
  // Phase 1 (2026-05-18): floor plan + reservations back-refs
  floorPlansPublished      FloorPlan[]               @relation("FloorPlanPublishedBy")
  floorPlanVersionsSaved   FloorPlanVersion[]        @relation("FloorPlanVersionSavedBy")
  guestProfilesAsFavorite  GuestProfile[]            @relation("GuestFavoriteServer")
  reservationsCreated      Reservation[]             @relation("ReservationCreatedBy")
  serverSectionAssignments ServerSectionAssignment[] @relation("ServerSectionAssignment")
  filesUploaded            UploadedFile[]            @relation("FileUploadedBy")
  // Phase 3b (2026-05-18): media uploads
  mediaUploaded            MediaItem[]               @relation("MediaUploadedBy")
  // Phase 4 (2026-05-18): tables this server is currently assigned to
  tablesAsCurrentServer    Table[]                   @relation("TableCurrentServer")
  // Gift cards this member issued
  giftCardsIssued          GiftCard[]                @relation("GiftCardIssuedBy")
  // Cash drawer activity
  cashDrawersOpened        CashDrawerSession[]       @relation("CashDrawerOpenedBy")
  cashDrawersClosed        CashDrawerSession[]       @relation("CashDrawerClosedBy")
  cashMovementsBy          CashMovement[]            @relation("CashMovementBy")
  timeClockEntries         TimeClockEntry[]          @relation("TimeClockEntries")
  tipPoolsCreated          TipPool[]                 @relation("TipPoolCreatedBy")
  tipPoolsClosed           TipPool[]                 @relation("TipPoolClosedBy")
  tipDistributions         TipDistribution[]         @relation("TipDistributionMember")
  integrationsConnected    IntegrationConnection[]   @relation("IntegrationConnectedBy")

  // Phase B (2026-07-30): purchase-order audit trail.
  purchaseOrdersCreated   PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersCancelled PurchaseOrder[] @relation("PurchaseOrderCancelledBy")

  // Phase C (2026-07-30) / Phase 2b (2026-08): the tenant member who filed
  // a merchant/supplier application, plus the tenant member who uploaded a
  // KYB document (either can be a merchant OWNER or a supplier owner).
  merchantApplicationsCreated MerchantApplication[] @relation("MerchantApplicationCreatedBy")
  kybDocumentsUploaded        KybDocument[]         @relation("KybDocumentUploadedBy")

  // Phase D #74 (2026-07-30): PO messages this member sent.
  poMessagesSent PurchaseOrderMessage[] @relation("PoMessageSender")

  // Phase E R1 (2026-07-31): per-technician working hours + time off
  // for appointment availability. Only technicians have these; other
  // roles keep the arrays empty.
  schedules StaffSchedule[]
  timeOff   StaffTimeOff[]

  @@unique([tenantId, userSub])
  @@unique([tenantId, email])
  @@index([userSub])
  @@index([email])
  @@map("memberships")
}

enum MemberRole {
  TENANT_OWNER // Full access: Admin Portal + All
  POS_ADMIN // Admin Portal (no billing) + Counter + Kitchen
  POS_MANAGER // Reports (view only) + Counter + Kitchen
  POS_STAFF // Counter POS only
  KITCHEN_STAFF // Kitchen Display only
}

enum MemberStatus {
  PENDING // Invited but not activated
  ACTIVE // Full access
  SUSPENDED // Temporarily disabled
}

// ============================================
// SECTION 3: SUBSCRIPTION & BILLING
// ============================================

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  plan               String             @default("standard") @db.VarChar(50)
  status             SubscriptionStatus @default(TRIAL)
  monthlyPrice       Int                @default(0) @map("monthly_price") // in cents
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

// B2B Monthly Billing Invoices (for subscription)
model BillingInvoice {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  invoiceNumber  String               @unique @map("invoice_number") @db.VarChar(50)
  amount         Int // in cents
  currency       String               @default("CAD") @db.VarChar(3)
  status         BillingInvoiceStatus @default(SENT)
  periodStart    DateTime             @map("period_start")
  periodEnd      DateTime             @map("period_end")
  dueDate        DateTime             @map("due_date")
  paidAt         DateTime?            @map("paid_at")
  paymentRef     String?              @map("payment_ref") @db.VarChar(255)
  paymentQrUrl   String?              @map("payment_qr_url") @db.VarChar(500)
  remindersSent  Int                  @default(0) @map("reminders_sent")
  lastReminderAt DateTime?            @map("last_reminder_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("billing_invoices")
}

enum BillingInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ============================================
// SECTION 4: TENANT SETTINGS
// ============================================

model TenantSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // Tax settings
  taxEnabled Boolean @default(true) @map("tax_enabled")
  taxRate    Decimal @default(13.00) @map("tax_rate") @db.Decimal(5, 2)
  taxLabel   String  @default("HST") @map("tax_label") @db.VarChar(20)

  // Secondary tax (e.g., PST in some provinces)
  tax2Enabled Boolean @default(false) @map("tax2_enabled")
  tax2Rate    Decimal @default(0) @map("tax2_rate") @db.Decimal(5, 2)
  tax2Label   String  @default("PST") @map("tax2_label") @db.VarChar(20)

  // Cash discount / dual pricing — SURCHARGE adds X% to card payments,
  // DISCOUNT subtracts X% for cash. Both are allowed under most US state
  // laws + CA (with disclosure). Percent capped at 15 by a DB CHECK.
  cashDiscountEnabled Boolean @default(false) @map("cash_discount_enabled")
  cashDiscountPercent Decimal @default(0) @map("cash_discount_percent") @db.Decimal(5, 2)
  cashDiscountMode    String  @default("SURCHARGE") @map("cash_discount_mode") @db.VarChar(20)
  cashDiscountLabel   String? @map("cash_discount_label") @db.VarChar(60)

  // Tip settings
  tipEnabled       Boolean @default(true) @map("tip_enabled")
  tipPresets       Json    @default("[15, 18, 20]") @map("tip_presets")
  tipCustomEnabled Boolean @default(true) @map("tip_custom_enabled")

  // Receipt settings
  receiptHeader  String? @map("receipt_header") @db.Text
  receiptFooter  String? @map("receipt_footer") @db.Text
  receiptLogoUrl String? @map("receipt_logo_url") @db.VarChar(500)

  // Order settings
  orderNumberPrefix String           @default("") @map("order_number_prefix") @db.VarChar(10)
  orderNumberReset  OrderNumberReset @default(DAILY) @map("order_number_reset")
  lastOrderNumber   Int              @default(0) @map("last_order_number")
  lastOrderDate     DateTime?        @map("last_order_date")

  // Kitchen settings
  kitchenDisplayEnabled Boolean @default(true) @map("kitchen_display_enabled")
  kitchenAlertSound     Boolean @default(true) @map("kitchen_alert_sound")
  prepTimeEnabled       Boolean @default(true) @map("prep_time_enabled")

  // Display settings
  customerDisplayEnabled     Boolean @default(true) @map("customer_display_enabled")
  showOrderDetails           Boolean @default(true) @map("show_order_details")
  // Salon next-appointment board: opt-in to show customer first names on
  // the public board (default false → board shows "Guest #0042").
  appointmentDisplayShowName Boolean @default(false) @map("appointment_display_show_name")

  // SMS integration (Phase 5e). Per-tenant — partners pick between the
  // shared ZASHX AWS SNS sender (no setup, billed per message) or BYO
  // Twilio credentials (advanced).
  smsEnabled             Boolean   @default(false) @map("sms_enabled")
  smsProvider            String    @default("shared") @map("sms_provider") @db.VarChar(20) // "shared" | "twilio"
  smsSenderLabel         String?   @map("sms_sender_label") @db.VarChar(60) // prepended to message body in shared mode
  smsTwilioAccountSidEnc String?   @map("sms_twilio_account_sid_enc")
  smsTwilioAuthTokenEnc  String?   @map("sms_twilio_auth_token_enc")
  smsTwilioFromNumber    String?   @map("sms_twilio_from_number") @db.VarChar(20)
  smsConnectedAt         DateTime? @map("sms_connected_at")

  // Google Business Profile integration (Phase 5e). OAuth-based — partner
  // signs in with the Google account that owns their GBP listing. Tokens
  // encrypted at rest. Location/Account IDs are GBP's internal resource
  // names ("accounts/123/locations/456") — needed for every API call.
  gbpConnected        Boolean   @default(false) @map("gbp_connected")
  gbpAccountResource  String?   @map("gbp_account_resource") @db.VarChar(120) // e.g. "accounts/1234567890"
  gbpLocationResource String?   @map("gbp_location_resource") @db.VarChar(120) // e.g. "locations/9876543210"
  gbpLocationName     String?   @map("gbp_location_name") @db.VarChar(255) // human-readable
  gbpAccessTokenEnc   String?   @map("gbp_access_token_enc")
  gbpRefreshTokenEnc  String?   @map("gbp_refresh_token_enc")
  gbpTokenExpiresAt   DateTime? @map("gbp_token_expires_at")
  gbpConnectedAt      DateTime? @map("gbp_connected_at")
  gbpLastSyncAt       DateTime? @map("gbp_last_sync_at")
  gbpLastSyncStatus   String?   @map("gbp_last_sync_status") @db.VarChar(20) // "ok" | "error"
  gbpLastSyncError    String?   @map("gbp_last_sync_error") @db.Text

  // Inventory settings
  lowStockAlertEnabled Boolean @default(true) @map("low_stock_alert_enabled")
  autoDeductInventory  Boolean @default(true) @map("auto_deduct_inventory")

  // Digital Waiter / Table Ordering settings
  tableOrderingEnabled Boolean          @default(true) @map("table_ordering_enabled")
  tablePaymentType     TablePaymentType @default(UPFRONT) @map("table_payment_type") // UPFRONT = pay before order, PAY_AT_END = pay when leaving
  allowGuestOrdering   Boolean          @default(true) @map("allow_guest_ordering") // Multiple guests can add to same session

  // Payment Terminal settings
  paymentTerminalEnabled Boolean @default(false) @map("payment_terminal_enabled")
  quickChipEnabled       Boolean @default(false) @map("quick_chip_enabled")
  lineItemDisplayEnabled Boolean @default(true) @map("line_item_display_enabled")

  // White-label branding
  brandName            String? @map("brand_name") @db.VarChar(255)
  // Widened to Text so a base64 data URL (~50–500KB) fits alongside
  // regular external URLs — same pattern as Product.imageUrl.
  brandLogoUrl         String? @map("brand_logo_url") @db.Text
  brandFaviconUrl      String? @map("brand_favicon_url") @db.VarChar(500)
  brandPrimaryColor    String  @default("#4F46E5") @map("brand_primary_color") @db.VarChar(7)
  brandAccentColor     String  @default("#6366F1") @map("brand_accent_color") @db.VarChar(7)
  brandBackgroundColor String  @default("#F9FAFB") @map("brand_background_color") @db.VarChar(7)
  poweredByVisible     Boolean @default(true) @map("powered_by_visible")
  customDomain         String? @unique @map("custom_domain") @db.VarChar(255)

  // Salon/Appointment settings
  appointmentBookingEnabled Boolean @default(false) @map("appointment_booking_enabled")
  bufferTimeMinutes         Int     @default(15) @map("buffer_time_minutes")

  // Phase E R2 (2026-07-31): reservation duration matrix — party-size
  // buckets → seating minutes. Server reads when the client doesn't
  // send an explicit estimatedDurationMinutes. Bucket keys are strings
  // ("1-2", "3-4", "5-6", "7+") so the JSON is self-documenting.
  partySizeDurationMap         Json @default("{\"1-2\": 60, \"3-4\": 90, \"5-6\": 120, \"7+\": 150}") @map("party_size_duration_map")
  // Turn buffer added to a reservation's window when checking for
  // overlapping bookings (cleanup / turn time between parties).
  reservationTurnBufferMinutes Int  @default(15) @map("reservation_turn_buffer_minutes")

  // Phase E R4 (2026-07-31): how close to a booking a customer can
  // cancel and still get a full refund. Displayed on the confirmation
  // + reminder messages so the customer knows the cutoff. Round 4b
  // will wire this into the actual refund path (needs deposit flow).
  cancellationWindowMinutes Int @default(30) @map("cancellation_window_minutes")

  // Phase E R6 (2026-07-31): appointment deposit flow. PUBLIC booking
  // only — POS-created appointments are pay-at-service. When require*
  // is true the confirm step redirects the customer to a hosted
  // deposit checkout; on success the appointment flips from
  // PENDING_PAYMENT → NEW.
  requireAppointmentDeposit Boolean @default(false) @map("require_appointment_deposit")
  // "PERCENT" (of subtotal) or "FIXED" (cents).
  appointmentDepositType    String  @default("PERCENT") @map("appointment_deposit_type") @db.VarChar(10)
  // Interpret per type: PERCENT=0..100 (25 = 25%); FIXED=cents (2500 = $25.00).
  appointmentDepositValue   Int     @default(25) @map("appointment_deposit_value")
  bookingAdvanceDays        Int     @default(30) @map("booking_advance_days")
  walkInEnabled             Boolean @default(true) @map("walk_in_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

enum OrderNumberReset {
  DAILY // Reset to 1 each day
  NEVER // Continuous numbering
}

enum TablePaymentType {
  UPFRONT // Pay before order is sent to kitchen (like fast food)
  PAY_AT_END // Pay when leaving (traditional restaurant)
}

// ============================================
// SECTION 5: PRODUCT CATALOG
// ============================================

// Menu Categories
model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  imageUrl    String?  @map("image_url") @db.VarChar(500) // External URL
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("categories")
}

// Products / Menu Items
model Product {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  // Basic info
  name        String  @db.VarChar(255)
  description String? @db.Text
  sku         String? @db.VarChar(50) // Internal code
  barcode     String? @db.VarChar(50) // For scanning

  // Optional tax category — nullable, falls back to TenantSettings.taxRate
  taxCategoryId String? @map("tax_category_id") @db.Uuid

  // Pricing (in cents)
  basePrice  Int @map("base_price")
  costPrice  Int @default(0) @map("cost_price") // Manual cost entry
  labourCost Int @default(0) @map("labour_cost") // Labour cost per item

  // Display
  imageUrl  String? @map("image_url") @db.Text // External URL or inline base64 data URL
  sortOrder Int     @default(0) @map("sort_order")

  // Availability
  isActive       Boolean @default(true) @map("is_active")
  isAvailable    Boolean @default(true) @map("is_available") // Can be sold (not out of stock)
  trackInventory Boolean @default(false) @map("track_inventory") // Track via ingredients

  // Kitchen
  prepTimeMinutes Int @default(0) @map("prep_time_minutes")

  // Salon/Service fields
  durationMinutes    Int?    @map("duration_minutes") // Service duration in minutes (null for restaurant products)
  requiresTechnician Boolean @default(false) @map("requires_technician")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category              Category               @relation(fields: [categoryId], references: [id])
  taxCategory           TaxCategory?           @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  variants              ProductVariant[]
  productModifierGroups ProductModifierGroup[]
  productAllergens      ProductAllergen[]
  recipes               Recipe[]
  orderItems            OrderItem[]
  stationProducts       StationProduct[]
  guestCartItems        GuestCartItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([tenantId, isActive])
  @@index([barcode])
  @@index([taxCategoryId])
  @@map("products")
}

// Product Variants (Small, Medium, Large, etc.)
model ProductVariant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  name            String   @db.VarChar(100) // "Small", "Large", "Spicy"
  priceAdjustment Int      @default(0) @map("price_adjustment") // +/- cents
  costAdjustment  Int      @default(0) @map("cost_adjustment") // +/- cents
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Modifier Groups (e.g., "Choose your sauce", "Add toppings")
model ModifierGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  displayName String?  @map("display_name") @db.VarChar(100) // Shown to customer
  isRequired  Boolean  @default(false) @map("is_required")
  minSelect   Int      @default(0) @map("min_select")
  maxSelect   Int      @default(1) @map("max_select") // 0 = unlimited
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

// Individual Modifiers (e.g., "Extra Cheese", "No Onions")
model Modifier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String   @db.VarChar(100)
  price     Int      @default(0) // Additional price in cents
  cost      Int      @default(0) // Cost in cents
  sortOrder Int      @default(0) @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default") // Pre-selected
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  group              ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

// Link Products to Modifier Groups
model ProductModifierGroup {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  // Relations
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ============================================
// SECTION 6: ALLERGENS
// ============================================

// Master Allergen List (can be tenant-specific or global)
model Allergen {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String           @unique @db.VarChar(20) // NUTS, DAIRY, GLUTEN, etc.
  name      String           @db.VarChar(100)
  icon      String?          @db.VarChar(50) // Icon name or emoji
  severity  AllergenSeverity @default(HIGH)
  isGlobal  Boolean          @default(true) @map("is_global") // Available to all tenants
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  productAllergens    ProductAllergen[]
  ingredientAllergens IngredientAllergen[]
  orderItemAllergens  OrderItemAllergen[]

  @@map("allergens")
}

enum AllergenSeverity {
  HIGH // Life-threatening (nuts, shellfish)
  MEDIUM // Significant reaction (dairy, gluten)
  LOW // Mild sensitivity
}

// Link Products to Allergens
model ProductAllergen {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  allergenId   String  @map("allergen_id") @db.Uuid
  isFromRecipe Boolean @default(false) @map("is_from_recipe") // Auto-inherited from ingredients

  // Relations
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([productId, allergenId])
  @@map("product_allergens")
}

// ============================================
// SECTION 7: INVENTORY & INGREDIENTS
// ============================================

// Units of Measure
model UnitOfMeasure {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String   @db.VarChar(50) // Kilogram, Gram, Liter, Piece
  symbol           String   @db.VarChar(10) // kg, g, L, pc
  type             UnitType // WEIGHT, VOLUME, COUNT
  baseUnit         String?  @map("base_unit") @db.VarChar(10) // g, ml, pc (for conversions)
  conversionFactor Decimal  @default(1) @map("conversion_factor") @db.Decimal(10, 4)
  isActive         Boolean  @default(true) @map("is_active")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  recipes     Recipe[]

  @@unique([tenantId, symbol])
  @@map("units_of_measure")
}

enum UnitType {
  WEIGHT // kg, g, lb, oz
  VOLUME // L, ml, gal
  COUNT // pc, dozen, box
}

// Suppliers — per-tenant INVENTORY reference records (contact info + notes,
// no login). Existed before the marketplace; kept as-is so inventory pages
// keep working.
//
// linkedTenantId (Phase 8, 2026-07-30) optionally points to the supplier's
// own marketplace tenant once they've accepted a merchant's invite. When set,
// this local record represents a "real" supplier we can order from through
// the marketplace; when null, it's just a paper record for inventory tracking.
model Supplier {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(255)
  contactName    String?  @map("contact_name") @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  address        String?  @db.Text
  notes          String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  linkedTenantId String?  @map("linked_tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedTenant Tenant?      @relation("SupplierLinkedTenant", fields: [linkedTenantId], references: [id], onDelete: SetNull)
  ingredients  Ingredient[]

  @@index([tenantId])
  @@index([linkedTenantId])
  @@map("suppliers")
}

// Ingredients (Raw Materials)
model Ingredient {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  sku         String? @db.VarChar(50)

  // Unit & Cost
  unitId      String @map("unit_id") @db.Uuid
  costPerUnit Int    @default(0) @map("cost_per_unit") // Cost in cents per unit

  // Stock Management. `lowStockThreshold` doubles as the PAR level for
  // auto-reorder (Phase D #77) — same concept, no duplicate column.
  lowStockThreshold Decimal @default(0) @map("low_stock_threshold") @db.Decimal(10, 3)

  // Supplier
  supplierId  String? @map("supplier_id") @db.Uuid
  supplierSku String? @map("supplier_sku") @db.VarChar(50)

  // Phase D #77 (2026-07-31): auto-reorder from par levels. When
  // autoReorderEnabled is true AND stock drops below lowStockThreshold,
  // the system drafts (or auto-submits) a PO to preferredSupplierTenantId
  // for reorderQty of preferredSupplierProductId. All fields must be set
  // together — the evaluator skips rows with any of them missing.
  reorderQty                 Decimal?  @map("reorder_qty") @db.Decimal(10, 3)
  preferredSupplierTenantId  String?   @map("preferred_supplier_tenant_id") @db.Uuid
  preferredSupplierProductId String?   @map("preferred_supplier_product_id") @db.Uuid
  autoReorderEnabled         Boolean   @default(false) @map("auto_reorder_enabled")
  // Cooldown so a burst of sales doesn't spam POs. Evaluator refuses to
  // draft again within a 24h window unless the last draft was cancelled.
  lastAutoReorderAt          DateTime? @map("last_auto_reorder_at")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                     UnitOfMeasure        @relation(fields: [unitId], references: [id])
  supplier                 Supplier?            @relation(fields: [supplierId], references: [id])
  allergens                IngredientAllergen[]
  recipes                  Recipe[]
  locationInventory        LocationInventory[]
  stockMovements           StockMovement[]
  preferredSupplierTenant  Tenant?              @relation("IngredientPreferredSupplier", fields: [preferredSupplierTenantId], references: [id], onDelete: SetNull)
  preferredSupplierProduct SupplierProduct?     @relation("IngredientPreferredSupplierProduct", fields: [preferredSupplierProductId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([supplierId])
  @@map("ingredients")
}

// Link Ingredients to Allergens
model IngredientAllergen {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid
  allergenId   String @map("allergen_id") @db.Uuid

  // Relations
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen   Allergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, allergenId])
  @@map("ingredient_allergens")
}

// Recipes - Link Products to Ingredients
model Recipe {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(10, 4) // Amount of ingredient needed
  unitId       String  @map("unit_id") @db.Uuid

  // Relations
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, ingredientId])
  @@map("recipes")
}

// Inventory per Location
model LocationInventory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String    @map("location_id") @db.Uuid
  ingredientId  String    @map("ingredient_id") @db.Uuid
  currentStock  Decimal   @default(0) @map("current_stock") @db.Decimal(10, 3)
  lastCountedAt DateTime? @map("last_counted_at")
  lastCountedBy String?   @map("last_counted_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([locationId, ingredientId])
  @@index([ingredientId])
  @@map("location_inventory")
}

// Stock Movements (Audit Trail)
model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  ingredientId  String            @map("ingredient_id") @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(10, 3) // Positive for IN, negative for OUT
  previousStock Decimal           @map("previous_stock") @db.Decimal(10, 3)
  newStock      Decimal           @map("new_stock") @db.Decimal(10, 3)
  reason        String?           @db.VarChar(255)
  orderId       String?           @map("order_id") @db.Uuid // If deducted for order
  performedById String?           @map("performed_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  // Relations
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order       Order?      @relation(fields: [orderId], references: [id])
  performedBy Membership? @relation("StockMovementBy", fields: [performedById], references: [id])

  @@index([locationId, ingredientId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE // Stock received from supplier
  SALE // Deducted for order
  ADJUSTMENT // Manual count adjustment
  WASTE // Spoilage/waste
  TRANSFER_IN // Received from another location
  TRANSFER_OUT // Sent to another location
  RETURN // Returned to supplier
}

// ============================================
// SECTION 8: TABLES & DIGITAL WAITER
// ============================================

model Table {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId  String      @map("location_id") @db.Uuid
  tableNumber String      @map("table_number") @db.VarChar(20) // "1", "A1", "Patio-3"
  name        String?     @db.VarChar(50) // "Window Seat", "VIP Booth"
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")

  // QR Code for self-ordering
  qrCode           String? @unique @map("qr_code") @db.VarChar(50) // Unique QR identifier
  qrCodeUrl        String? @map("qr_code_url") @db.Text // Generated QR image data URL (base64)
  currentSessionId String? @map("current_session_id") @db.Uuid

  // ─────────────────────────────────────────────────────────────
  // Floor plan integration (Phase 1, 2026-05-18)
  // Existing rows have nullable floorPlanId/sectionId; new tables
  // created via the visual editor will have them populated.
  // ─────────────────────────────────────────────────────────────
  floorPlanId   String?    @map("floor_plan_id") @db.Uuid
  sectionId     String?    @map("section_id") @db.Uuid
  displayLabel  String?    @map("display_label") @db.VarChar(50) // optional alt vs tableNumber
  shape         TableShape @default(ROUND)
  customPolygon Json?      @map("custom_polygon") // for shape=CUSTOM (array of [x,y])
  x             Float      @default(0)
  y             Float      @default(0)
  width         Float      @default(80)
  height        Float      @default(80)
  rotation      Float      @default(0) // degrees
  minPartySize  Int        @default(1) @map("min_party_size")
  maxPartySize  Int?       @map("max_party_size") // null = falls back to capacity
  revenueCenter String?    @map("revenue_center") @db.VarChar(50)
  isBookable    Boolean    @default(true) @map("is_bookable")
  zIndex        Int        @default(0) @map("z_index")

  // Phase 4 (2026-05-18): live state for floor view (drives status colors,
  // server-color fill, turn-time progress bar)
  currentServerId    String?   @map("current_server_id") @db.Uuid
  seatedAt           DateTime? @map("seated_at")
  guestCount         Int?      @map("guest_count")
  lastStatusChangeAt DateTime? @map("last_status_change_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  location           Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  floorPlan          FloorPlan?      @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  section            Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  orders             Order[]
  sessions           TableSession[]
  reservations       Reservation[]
  waitlistSeatings   WaitlistEntry[]
  // Phase 3c (2026-05-18): hotspots in 360° scenes that link to this table
  tourHotspotTargets TourHotspot[]   @relation("HotspotTargetTable")
  // Phase 4 (2026-05-18): current server (who's serving this table right now)
  currentServer      Membership?     @relation("TableCurrentServer", fields: [currentServerId], references: [id], onDelete: SetNull)

  @@unique([locationId, tableNumber])
  @@index([locationId])
  @@index([qrCode])
  @@index([floorPlanId])
  @@index([sectionId])
  @@map("tables")
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  BOOTH
  BAR
  CUSTOM
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BLOCKED
}

// Table Session - Tracks a dining session from arrival to payment
model TableSession {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId    String        @map("table_id") @db.Uuid
  locationId String        @map("location_id") @db.Uuid
  status     SessionStatus @default(ACTIVE)
  guestCount Int           @default(1) @map("guest_count")

  // Session settings
  allowGroupOrdering Boolean @default(true) @map("allow_group_ordering")
  requireApproval    Boolean @default(false) @map("require_approval") // Host approves orders

  // Timing
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  endedAt        DateTime? @map("ended_at")

  // Totals
  totalSpent Int @default(0) @map("total_spent") // Running total in cents

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  table        Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id])
  guests       TableGuest[]
  orders       Order[]         @relation("SessionOrders")
  requests     TableRequest[]
  promptsShown SessionPrompt[]

  @@index([tableId])
  @@index([locationId])
  @@index([status])
  @@map("table_sessions")
}

enum SessionStatus {
  ACTIVE // Guests at table
  ORDERING // Currently placing order
  DINING // Food served, eating
  PAYMENT_PENDING // Waiting for payment
  COMPLETED // Session ended
  CANCELLED // Abandoned
}

// Table Guest - Individual person at a table
model TableGuest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  guestName  String?  @map("guest_name") @db.VarChar(100)
  guestToken String   @unique @map("guest_token") @db.VarChar(100) // Browser token
  isHost     Boolean  @default(false) @map("is_host")
  joinedAt   DateTime @default(now()) @map("joined_at")

  // Relations
  session    TableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cartItems  GuestCartItem[]
  orderItems OrderItem[]     @relation("GuestOrderItems")

  @@index([sessionId])
  @@index([guestToken])
  @@map("table_guests")
}

// Guest Cart Item - Items in a guest's cart before ordering
model GuestCartItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId             String  @map("guest_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  quantity            Int     @default(1)
  unitPrice           Int     @map("unit_price") // Price in cents
  modifiers           Json? // [{modifierId, name, price, quantity}]
  specialInstructions String? @map("special_instructions") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  guest   TableGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([guestId])
  @@map("guest_cart_items")
}

// Table Request - Customer requests (water, help, bill)
model TableRequest {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  guestId   String?       @map("guest_id") @db.Uuid
  type      RequestType
  status    RequestStatus @default(PENDING)
  note      String?       @db.VarChar(255)

  createdAt      DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  completedAt    DateTime? @map("completed_at")
  respondedById  String?   @map("responded_by_id") @db.Uuid

  // Relations
  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@map("table_requests")
}

enum RequestType {
  WATER
  HELP
  BILL
  REFILL
  NAPKINS
  CUSTOM
}

enum RequestStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

// Bill Split for table ordering
model BillSplit {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  splitType SplitType @map("split_type")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items BillSplitItem[]

  @@index([orderId])
  @@map("bill_splits")
}

enum SplitType {
  EQUAL // Divide total by guest count
  BY_GUEST // Each pays for their own items
  CUSTOM // Manual assignment
  SINGLE // One person pays all
}

model BillSplitItem {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billSplitId String        @map("bill_split_id") @db.Uuid
  guestId     String?       @map("guest_id") @db.Uuid
  guestName   String?       @map("guest_name") @db.VarChar(100)
  amount      Int // Amount in cents
  tipAmount   Int           @default(0) @map("tip_amount")
  status      PaymentStatus @default(PENDING)
  paymentId   String?       @map("payment_id") @db.Uuid
  paidAt      DateTime?     @map("paid_at")

  // Relations
  billSplit BillSplit @relation(fields: [billSplitId], references: [id], onDelete: Cascade)

  @@index([billSplitId])
  @@map("bill_split_items")
}

// ============================================
// SECTION 9: ORDERS
// ============================================

model Order {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId  String  @map("location_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid

  // Order identification
  orderNumber   String @map("order_number") @db.VarChar(50)
  displayNumber Int    @map("display_number") // Short number for kitchen (1-999)

  // Order type
  orderType OrderType @default(DINE_IN) @map("order_type")
  tableId   String?   @map("table_id") @db.Uuid // For DINE_IN

  // Customer info (for takeaway/delivery)
  customerName  String? @map("customer_name") @db.VarChar(255)
  customerPhone String? @map("customer_phone") @db.VarChar(20)
  customerEmail String? @map("customer_email") @db.VarChar(255)

  // Delivery info
  deliveryAddress String? @map("delivery_address") @db.Text
  deliveryNotes   String? @map("delivery_notes") @db.Text

  // Status
  status OrderStatus @default(NEW)

  // Amounts (all in cents)
  subtotal        Int    @default(0)
  taxAmount       Int    @default(0) @map("tax_amount")
  tax2Amount      Int    @default(0) @map("tax2_amount")
  discountAmount  Int    @default(0) @map("discount_amount")
  // Card-processing surcharge applied when the customer paid with a
  // non-cash method under SURCHARGE mode. Always >= 0. Cash discounts
  // land in discountAmount with a note instead.
  surchargeAmount Int    @default(0) @map("surcharge_amount")
  tipAmount       Int    @default(0) @map("tip_amount")
  total           Int    @default(0)
  currency        String @default("CAD") @db.VarChar(3)

  // Cost tracking (for profit calculation)
  totalCost Int @default(0) @map("total_cost") // Sum of item costs

  // Notes
  notes String? @db.Text

  // Payment tracking
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod    String?       @map("payment_method") @db.VarChar(50)
  paymentUrl       String?       @map("payment_url") @db.VarChar(500)
  paymentQrData    String?       @map("payment_qr_data") @db.Text
  paymentExpiresAt DateTime?     @map("payment_expires_at")

  // Timestamps
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Offline sync
  offlineId String?   @unique @map("offline_id") @db.VarChar(100)
  syncedAt  DateTime? @map("synced_at")

  // Table Session for digital waiter
  sessionId String? @map("session_id") @db.Uuid

  // Appointment fields (salon)
  appointmentDate DateTime? @map("appointment_date") @db.Date
  appointmentTime String?   @map("appointment_time") @db.VarChar(5) // "14:30" format

  // Phase E R4 (2026-07-31): appointment reminder timestamps. Cron
  // stamps each one when it fires the corresponding reminder — nulls =
  // not yet sent. Mirrors the reservation reminder columns.
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at")
  reminder12hSentAt DateTime? @map("reminder_12h_sent_at")
  reminder4hSentAt  DateTime? @map("reminder_4h_sent_at")

  // Relations
  location             Location              @relation(fields: [locationId], references: [id])
  createdBy            Membership?           @relation("CreatedByMember", fields: [createdById], references: [id])
  table                Table?                @relation(fields: [tableId], references: [id])
  session              TableSession?         @relation("SessionOrders", fields: [sessionId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  kitchenQueue         KitchenQueue[]
  stockMovements       StockMovement[]
  billSplits           BillSplit[]
  // Gift card ledger entries created against this order (redemptions/refunds)
  giftCardTransactions GiftCardTransaction[] @relation("OrderGiftCardTxns")
  cashMovements        CashMovement[]        @relation("OrderCashMovements")
  deliverectOrder      DeliverectOrder?      @relation("DeliverectOrder")

  @@unique([locationId, orderNumber])
  @@index([locationId, status])
  @@index([createdAt])
  @@index([status])
  @@index([appointmentDate])
  @@map("orders")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  APPOINTMENT
}

enum OrderStatus {
  PENDING_PAYMENT // Waiting for payment (UPFRONT table orders)
  NEW // Just created
  CONFIRMED // Confirmed, sent to kitchen
  PREPARING // Kitchen is working on it
  READY // Ready for pickup/serve
  SERVED // Served to customer (dine-in)
  PICKED_UP // Customer picked up (takeaway)
  DELIVERED // Delivered (delivery)
  COMPLETED // Fully completed
  CANCELLED // Cancelled
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Order Items
model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  // Item details (copied at time of order for historical accuracy)
  productName String  @map("product_name") @db.VarChar(255)
  variantName String? @map("variant_name") @db.VarChar(100)

  // Quantity & Pricing
  quantity       Int @default(1)
  unitPrice      Int @map("unit_price") // Base price in cents
  modifiersTotal Int @default(0) @map("modifiers_total") // Sum of modifier prices
  itemTotal      Int @map("item_total") // (unitPrice + modifiersTotal) * quantity

  // Cost (for profit tracking)
  unitCost Int @default(0) @map("unit_cost") // Cost in cents

  // Special instructions
  specialInstructions String? @map("special_instructions") @db.Text

  // Kitchen status
  status          OrderItemStatus @default(PENDING)
  sentToKitchenAt DateTime?       @map("sent_to_kitchen_at")
  preparedAt      DateTime?       @map("prepared_at")

  // Digital waiter - link to guest who ordered
  guestId String? @map("guest_id") @db.Uuid

  // Salon/Appointment scheduling
  technicianId   String?   @map("technician_id") @db.Uuid
  scheduledStart DateTime? @map("scheduled_start")
  scheduledEnd   DateTime? @map("scheduled_end")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id])
  variant       ProductVariant?     @relation(fields: [variantId], references: [id])
  guest         TableGuest?         @relation("GuestOrderItems", fields: [guestId], references: [id])
  technician    Membership?         @relation("TechnicianAssignments", fields: [technicianId], references: [id])
  modifiers     OrderItemModifier[]
  allergenNotes OrderItemAllergen[]
  kitchenQueue  KitchenQueue[]

  @@index([orderId])
  @@index([productId])
  @@index([technicianId])
  @@map("order_items")
}

enum OrderItemStatus {
  PENDING // Not yet sent to kitchen
  COOKING // Being prepared
  READY // Ready to serve
  SERVED // Served/delivered
  CANCELLED // Cancelled
}

// Order Item Modifiers
model OrderItemModifier {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  modifierId  String @map("modifier_id") @db.Uuid

  // Copied at time of order
  modifierName String @map("modifier_name") @db.VarChar(100)
  price        Int // Price at time of order

  // Relations
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// Order Item Allergen Notes (CRITICAL for kitchen)
model OrderItemAllergen {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  allergenId  String  @map("allergen_id") @db.Uuid
  note        String  @db.VarChar(255) // "NO NUTS - CUSTOMER ALLERGY"
  isAllergy   Boolean @default(true) @map("is_allergy") // True = allergy, False = preference

  // Relations
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  allergen  Allergen  @relation(fields: [allergenId], references: [id])

  @@index([orderItemId])
  @@map("order_item_allergens")
}

// ============================================
// SECTION 10: PAYMENTS
// ============================================

model Payment {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  // Provider info
  provider       String  @db.VarChar(50) // 'itip', 'cash', 'card', etc.
  providerRef    String? @map("provider_ref") @db.VarChar(255)
  providerStatus String? @map("provider_status") @db.VarChar(50)

  // Payment details
  amount   Int // in cents
  currency String              @default("CAD") @db.VarChar(3)
  status   PaymentRecordStatus @default(PENDING)
  method   String?             @db.VarChar(50) // 'card', 'apple_pay', 'cash'

  // Metadata
  metadata      Json?
  failureReason String? @map("failure_reason") @db.Text

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds              Refund[]
  giftCardTransactions GiftCardTransaction[] @relation("PaymentGiftCardTxns")
  cashMovements        CashMovement[]        @relation("PaymentCashMovements")

  @@index([orderId])
  @@index([providerRef])
  @@index([status])
  @@map("payments")
}

enum PaymentRecordStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Refund {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String       @map("payment_id") @db.Uuid
  amount        Int // in cents
  reason        String?      @db.VarChar(255)
  status        RefundStatus @default(PENDING)
  providerRef   String?      @map("provider_ref") @db.VarChar(255)
  initiatedById String?      @map("initiated_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  completedAt   DateTime?    @map("completed_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// SECTION 10b: GIFT CARDS
// ============================================
// Stored-value cards, digital (emailed code) or physical (printed).
// Balance decrements as customers redeem against orders. Ledger table
// keeps an audit trail of every issue / redeem / refund / adjustment.

model GiftCard {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String @db.VarChar(32)

  type   GiftCardType   @default(DIGITAL)
  status GiftCardStatus @default(ACTIVE)

  initialAmount Int    @map("initial_amount") // cents
  balance       Int // cents
  currency      String @default("CAD") @db.VarChar(3)

  recipientName  String? @map("recipient_name") @db.VarChar(255)
  recipientEmail String? @map("recipient_email") @db.VarChar(255)
  recipientPhone String? @map("recipient_phone") @db.VarChar(32)
  senderName     String? @map("sender_name") @db.VarChar(255)
  message        String? @db.Text

  batchId String? @map("batch_id") @db.Uuid

  issuedById      String?   @map("issued_by_id") @db.Uuid
  issuedAt        DateTime  @default(now()) @map("issued_at")
  expiresAt       DateTime? @map("expires_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuedBy     Membership?           @relation("GiftCardIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, batchId])
  @@index([recipientEmail])
  @@map("gift_cards")
}

enum GiftCardType {
  DIGITAL
  PHYSICAL
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCardTransaction {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  giftCardId String  @map("gift_card_id") @db.Uuid
  orderId    String? @map("order_id") @db.Uuid
  paymentId  String? @map("payment_id") @db.Uuid

  type         GiftCardTxnType
  amount       Int // signed cents: +credit / -debit
  balanceAfter Int             @map("balance_after")

  notes         String? @db.Text
  performedById String? @map("performed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation("OrderGiftCardTxns", fields: [orderId], references: [id], onDelete: SetNull)
  payment  Payment? @relation("PaymentGiftCardTxns", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([orderId])
  @@map("gift_card_transactions")
}

enum GiftCardTxnType {
  ISSUE
  REDEEM
  REFUND
  ADJUSTMENT
  CANCEL
}

// ============================================
// SECTION 10c: CASH DRAWER SESSIONS
// ============================================
// One session per cashier shift (or per terminal, per day). Auto-logs
// cash payments as PAYMENT movements; PAYOUT/PAYIN/DROP are entered
// manually. Closing count vs expected reveals over/short.

model CashDrawerSession {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  terminalId String? @map("terminal_id") @db.Uuid

  status CashDrawerStatus @default(OPEN)

  openingFloat Int      @map("opening_float") // cents
  openingNote  String?  @map("opening_note") @db.Text
  openedById   String?  @map("opened_by_id") @db.Uuid
  openedAt     DateTime @default(now()) @map("opened_at")

  closingCount Int?      @map("closing_count")
  expectedCash Int?      @map("expected_cash")
  variance     Int? // closingCount - expectedCash (± cents)
  closingNote  String?   @map("closing_note") @db.Text
  closedById   String?   @map("closed_by_id") @db.Uuid
  closedAt     DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  terminal  Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  openedBy  Membership?    @relation("CashDrawerOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy  Membership?    @relation("CashDrawerClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements CashMovement[]

  @@index([tenantId, status])
  @@index([openedAt])
  @@map("cash_drawer_sessions")
}

enum CashDrawerStatus {
  OPEN
  CLOSED
}

model CashMovement {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  type   CashMovementType
  amount Int // signed cents: +in / -out

  orderId   String? @map("order_id") @db.Uuid
  paymentId String? @map("payment_id") @db.Uuid

  reason        String? @db.Text
  performedById String? @map("performed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  session     CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order       Order?            @relation("OrderCashMovements", fields: [orderId], references: [id], onDelete: SetNull)
  payment     Payment?          @relation("PaymentCashMovements", fields: [paymentId], references: [id], onDelete: SetNull)
  performedBy Membership?       @relation("CashMovementBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([paymentId])
  @@map("cash_movements")
}

enum CashMovementType {
  OPENING
  PAYMENT
  REFUND
  PAYOUT
  PAYIN
  DROP
  CLOSING
}

// ============================================
// SECTION 10d: EMPLOYEE TIME CLOCK
// ============================================
// One entry per shift (open at clock-in, closed at clock-out). Breaks
// live in their own table so multi-break shifts are cleanly auditable.
// total_minutes and break_minutes are stamped at close so timesheet
// reports don't have to sum breaks on every read.

model TimeClockEntry {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  status TimeClockStatus @default(ACTIVE)

  clockedInAt  DateTime  @default(now()) @map("clocked_in_at")
  clockedOutAt DateTime? @map("clocked_out_at")

  totalMinutes Int? @map("total_minutes")
  breakMinutes Int? @map("break_minutes")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership       @relation("TimeClockEntries", fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location         @relation("TimeClockLocation", fields: [locationId], references: [id], onDelete: Cascade)
  breaks     TimeClockBreak[]

  @@index([tenantId, clockedInAt])
  @@index([membershipId, clockedInAt])
  @@map("time_clock_entries")
}

enum TimeClockStatus {
  ACTIVE
  ON_BREAK
  CLOSED
}

model TimeClockBreak {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId String @map("entry_id") @db.Uuid

  type TimeClockBreakType @default(REST)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  minutes   Int?

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  entry TimeClockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, startedAt])
  @@map("time_clock_breaks")
}

enum TimeClockBreakType {
  MEAL
  REST
}

// ============================================
// SECTION 10e: TAX CATEGORIES + LOCATION OVERRIDES
// ============================================
// Product-level tax categories (Standard / Zero-rated / Reduced etc.)
// with optional per-location rate overrides. Falls back to
// TenantSettings.taxRate when a product has no category.

model TaxCategory {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String  @db.VarChar(100)
  ratePercent Decimal @map("rate_percent") @db.Decimal(5, 2)
  description String? @db.Text

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products          Product[]
  locationOverrides LocationTaxRate[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("tax_categories")
}

// ============================================
// SECTION 10f: TIP POOLS + DISTRIBUTION
// ============================================
// Pool tips over a shift period and redistribute to clocked-in staff by
// hours, evenly, or by role weights. See migration file for lifecycle.

model TipPool {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  status TipPoolStatus @default(OPEN)
  rule   TipPoolRule   @default(BY_HOURS)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  tipsCollected Int @default(0) @map("tips_collected")

  // Snapshot of role weights when rule = BY_ROLE
  roleWeights Json? @map("role_weights")

  notes String? @db.Text

  createdById String?   @map("created_by_id") @db.Uuid
  closedById  String?   @map("closed_by_id") @db.Uuid
  closedAt    DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location          @relation("TipPoolLocation", fields: [locationId], references: [id], onDelete: Cascade)
  createdBy     Membership?       @relation("TipPoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy      Membership?       @relation("TipPoolClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  distributions TipDistribution[]

  @@index([tenantId, periodStart])
  @@index([locationId, periodStart])
  @@index([tenantId, status])
  @@map("tip_pools")
}

enum TipPoolStatus {
  OPEN
  DISTRIBUTED
  CLOSED
}

enum TipPoolRule {
  BY_HOURS
  EVENLY
  BY_ROLE
}

// ============================================
// SECTION 10g: INTEGRATION CONNECTIONS
// ============================================
// OAuth-token storage for external accounting integrations. Currently
// wired for QBO US + QBO CA (separate Intuit apps with different API
// base URLs). Extensible to Xero / FreshBooks / Sage later.

model IntegrationConnection {
  id       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  provider IntegrationProvider
  status   IntegrationStatus   @default(DISCONNECTED)

  // OAuth tokens — encrypted at rest via lib/integration-crypto.ts
  accessTokenEnc     String?   @map("access_token_enc") @db.Text
  refreshTokenEnc    String?   @map("refresh_token_enc") @db.Text
  accessTokenExpires DateTime? @map("access_token_expires")

  realmId     String? @map("realm_id") @db.VarChar(64)
  companyName String? @map("company_name") @db.VarChar(255)

  // Chart-of-Accounts mapping refs (QBO Account IDs — strings)
  salesAccountRef     String? @map("sales_account_ref") @db.VarChar(64)
  taxLiabilityRef     String? @map("tax_liability_ref") @db.VarChar(64)
  tipsLiabilityRef    String? @map("tips_liability_ref") @db.VarChar(64)
  discountsAccountRef String? @map("discounts_account_ref") @db.VarChar(64)
  refundsAccountRef   String? @map("refunds_account_ref") @db.VarChar(64)
  cashAccountRef      String? @map("cash_account_ref") @db.VarChar(64)
  cardAccountRef      String? @map("card_account_ref") @db.VarChar(64)

  // Deliverect-specific — merchant's Deliverect location id + API creds +
  // per-connection webhook secret for HMAC verification. Kept alongside
  // the QBO fields so we don't need one integration table per provider.
  externalLocationId String? @map("external_location_id") @db.VarChar(64)
  webhookSecretEnc   String? @map("webhook_secret_enc") @db.Text
  apiKeyEnc          String? @map("api_key_enc") @db.Text
  apiSecretEnc       String? @map("api_secret_enc") @db.Text

  lastSyncAt  DateTime? @map("last_sync_at")
  lastError   String?   @map("last_error") @db.Text
  lastErrorAt DateTime? @map("last_error_at")

  connectedById String?   @map("connected_by_id") @db.Uuid
  connectedAt   DateTime? @map("connected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy      Membership?          @relation("IntegrationConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  syncLogs         IntegrationSyncLog[]
  deliverectOrders DeliverectOrder[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([externalLocationId])
  @@map("integration_connections")
}

// Deliverect-inbound order provenance. One row per delivery-aggregator
// order we've received via the webhook. `externalOrderId` is the
// idempotency key — a retried webhook maps to the same Order row.
model DeliverectOrder {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  // @unique required for the one-to-one back-relation on Order — every
  // delivery order maps to exactly one iTAP Order row and vice versa.
  orderId      String @unique @map("order_id") @db.Uuid

  externalOrderId    String  @map("external_order_id") @db.VarChar(128)
  channel            String  @db.VarChar(50) // 'doordash' | 'uber_eats' | 'skip'
  channelOrderNumber String? @map("channel_order_number") @db.VarChar(64)
  rawPayload         Json    @map("raw_payload")

  receivedAt DateTime @default(now()) @map("received_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  order      Order                 @relation("DeliverectOrder", fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalOrderId])
  @@index([channel, receivedAt])
  @@map("deliverect_orders")
}

enum IntegrationProvider {
  QUICKBOOKS_US
  QUICKBOOKS_CA
  DELIVERECT
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  REVOKED
}

model IntegrationSyncLog {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  businessDate DateTime @map("business_date") @db.Date
  dryRun       Boolean  @default(false) @map("dry_run")
  success      Boolean  @default(false)

  payload  Json
  response Json?
  error    String? @db.Text

  externalRef String? @map("external_ref") @db.VarChar(64)

  performedById String?  @map("performed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, businessDate])
  @@index([connectionId, success, businessDate])
  @@map("integration_sync_log")
}

model TipDistribution {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId       String @map("pool_id") @db.Uuid
