// Upsell Rules - Owner-defined suggestions
model UpsellRule {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true) @map("is_active")
  priority    Int     @default(0) // Higher = shown first

  // Trigger conditions
  triggerType         UpsellTriggerType @map("trigger_type")
  triggerProducts     String[]          @map("trigger_products") // Product IDs that trigger this
  triggerCategories   String[]          @map("trigger_categories") // Category IDs that trigger this
  triggerMinCartValue Int?              @map("trigger_min_cart_value") // Minimum cart value to trigger
  triggerMaxCartValue Int?              @map("trigger_max_cart_value") // Don't upsell high spenders

  // Time conditions
  activeStartTime String? @map("active_start_time") @db.VarChar(5) // "11:00"
  activeEndTime   String? @map("active_end_time") @db.VarChar(5) // "14:00"
  activeDays      Int[]   @map("active_days") // [1,2,3,4,5] Mon-Fri

  // What to suggest
  suggestProducts   String[] @map("suggest_products") // Product IDs to suggest
  suggestCategories String[] @map("suggest_categories") // Show from these categories
  suggestMessage    String?  @map("suggest_message") @db.VarChar(255)
  suggestDiscount   Int?     @map("suggest_discount") // Optional discount percentage

  // Display settings
  displayType  UpsellDisplayType @default(MODAL) @map("display_type")
  displayImage String?           @map("display_image") @db.VarChar(500)

  // Analytics
  impressions Int @default(0)
  acceptances Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@map("upsell_rules")
}

enum UpsellTriggerType {
  PRODUCT_ADDED // When specific product added to cart
  CATEGORY_ADDED // When product from category added
  CART_VALUE // When cart reaches certain value
  CHECKOUT // At checkout
  POST_ORDER // After order submitted
  TIME_BASED // After X minutes at table
}

enum UpsellDisplayType {
  MODAL // Full modal popup
  BANNER // Top/bottom banner
  INLINE // Inline suggestion
  TOAST // Quick toast notification
}

// Smart Prompts - Time-based suggestions
