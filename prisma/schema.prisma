  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  rewardId   String   @map("reward_id") @db.Uuid
  pointsUsed Int      @map("points_used")
  orderId    String?  @map("order_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  // Relations
  customer CustomerLoyalty @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   LoyaltyReward   @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@map("reward_redemptions")
}

// Spin Wheel Prizes
model SpinWheelPrize {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String     @map("program_id") @db.Uuid
  name        String     @db.VarChar(100)
  probability Int // Percentage chance (all should sum to 100)
  prizeType   RewardType @map("prize_type")
  prizeValue  Int        @map("prize_value")
  color       String?    @db.VarChar(7) // Hex color for wheel
  isActive    Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("spin_wheel_prizes")
}

// ============================================
// SECTION 16: STAFF NOTIFICATIONS
// ============================================

model StaffNotification {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String               @map("location_id") @db.Uuid
  type       NotificationType
  title      String               @db.VarChar(100)
  message    String               @db.VarChar(500)
  priority   NotificationPriority @default(NORMAL)

  // References
  tableId   String? @map("table_id") @db.Uuid
  orderId   String? @map("order_id") @db.Uuid
  requestId String? @map("request_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  status      NotificationStatus @default(UNREAD)
  targetRoles String[]           @map("target_roles") // ["POS_STAFF", "KITCHEN_STAFF"]

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  readById  String?   @map("read_by_id") @db.Uuid

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([status])
  @@index([type])
  @@map("staff_notifications")
}

enum NotificationType {
  TABLE_REQUEST // Customer needs help
  ORDER_READY // Kitchen completed order
  KITCHEN_DELAY // Order is delayed
  PAYMENT_RECEIVED // Payment completed
  NEW_ORDER // New order placed
  LOW_STOCK // Inventory alert
  SESSION_LONG // Table has been occupied too long
  CUSTOM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  RESOLVED
}

// ============================================
// SECTION 17: PAYMENT TERMINALS (Global Payments UPA)
// ============================================

model Terminal {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId   String         @map("location_id") @db.Uuid
  name         String         @db.VarChar(100)
  // ipAddress + port are only used by legacy UPA (TCP) terminals. UCI
  // terminals reach us through Global Payments' cloud, so they don't have
  // a local IP — the DB was migrated to nullable in 017_terminals_uci.sql
  // but the Prisma schema was left out of sync until now.
  ipAddress    String?        @map("ip_address") @db.VarChar(45)
  port         Int?           @default(8081)
  serialNumber String?        @map("serial_number") @db.VarChar(100)
  model        String?        @db.VarChar(100)
  status       TerminalStatus @default(OFFLINE)
  isDefault    Boolean        @default(false) @map("is_default")
  lastPingAt   DateTime?      @map("last_ping_at")
  lastEodAt    DateTime?      @map("last_eod_at")
  ecrId        String         @default("13") @map("ecr_id") @db.VarChar(10)
  metadata     Json?

  // UCI (Global Payments cloud) — added in 017_terminals_uci.sql
  provider       String  @default("UCI") @db.VarChar(20)
  uciLane        String? @map("uci_lane") @db.VarChar(50)
  uciMerchantId  String? @map("uci_merchant_id") @db.VarChar(50)
  uciEnvironment String? @default("CERT") @map("uci_environment") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  location           Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  transactions       TerminalTransaction[]
  cashDrawerSessions CashDrawerSession[]

  // Old (locationId, ipAddress, port) unique constraint was DROPPED in
  // 017_terminals_uci.sql — replaced with two partial unique indexes
  // (one for UCI on uci_lane, one for UPA on ip_address+port). Prisma
  // can't express partial indexes, so we just index locationId here and
  // trust the DB-level constraints.
  @@index([locationId])
  @@index([uciLane])
  @@map("terminals")
}

enum TerminalStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

model TerminalTransaction {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  terminalId String  @map("terminal_id") @db.Uuid
  orderId    String? @map("order_id") @db.Uuid
  paymentId  String? @map("payment_id") @db.Uuid

  command         String  @db.VarChar(50)
  transactionType String? @map("transaction_type") @db.VarChar(20)
  requestId       String  @map("request_id") @db.VarChar(50)
  requestPayload  Json    @map("request_payload")
  responsePayload Json?   @map("response_payload")

  amount    Int?
  tipAmount Int?   @map("tip_amount")
  currency  String @default("CAD") @db.VarChar(3)

  result       String? @db.VarChar(20)
  errorCode    String? @map("error_code") @db.VarChar(20)
  errorMessage String? @map("error_message") @db.Text

  referenceNumber String? @map("reference_number") @db.VarChar(50)
  transactionId   String? @map("gp_transaction_id") @db.VarChar(50)
  authCode        String? @map("auth_code") @db.VarChar(20)
  cardType        String? @map("card_type") @db.VarChar(20)
  maskedPan       String? @map("masked_pan") @db.VarChar(20)
  entryMode       String? @map("entry_mode") @db.VarChar(20)

  status      TerminalTxStatus @default(SENT)
  sentAt      DateTime         @default(now()) @map("sent_at")
  respondedAt DateTime?        @map("responded_at")

  // Relations
  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId])
  @@index([orderId])
  @@index([referenceNumber])
  @@index([requestId])
  @@map("terminal_transactions")
}

enum TerminalTxStatus {
  SENT
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

// ============================================================================
// SECTION 14: FLOOR PLAN + RESERVATIONS + UPLOADS  (Phase 1, 2026-05-18)
// ============================================================================
//
// Floor plans live PER LOCATION. A location can have multiple floor plans
// (Main Dining, Patio, Mezzanine). Each floor plan has Sections (Bar, VIP)
// and Tables (extended from existing tables table with x/y/shape fields).
//
// Reservations are independent records that bind to a table only at the
// moment of seating (Toast pattern — keeps host flexible).
//
// UploadedFile tracks S3 objects per-tenant with strict isolation (DB
// trigger enforces s3_key MUST start with tenant_id/).

model FloorPlan {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId   String  @map("location_id") @db.Uuid
  name         String  @db.VarChar(100)
  floorNumber  Int     @default(1) @map("floor_number")
  displayOrder Int     @default(0) @map("display_order")
  description  String? @db.Text

  // Canvas (logical units, not pixels)
  canvasWidth       Int     @default(1200) @map("canvas_width")
  canvasHeight      Int     @default(800) @map("canvas_height")
  gridSize          Int     @default(20) @map("grid_size")
  backgroundUrl     String? @map("background_url") @db.VarChar(500)
  backgroundOpacity Float   @default(0.5) @map("background_opacity")

  // Versioning
  currentVersion    Int     @default(1) @map("current_version")
  layoutJson        Json    @default("{}") @map("layout_json")
  draftJson         Json?   @map("draft_json")
  hasUnsavedChanges Boolean @default(false) @map("has_unsaved_changes")

  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  location    Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  publishedBy Membership?        @relation("FloorPlanPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  sections    Section[]
  tables      Table[]
  versions    FloorPlanVersion[]

  @@index([locationId])
  @@index([locationId, isActive], name: "idx_floor_plans_active")
  @@map("floor_plans")
}

model FloorPlanVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floorPlanId   String   @map("floor_plan_id") @db.Uuid
  versionNumber Int      @map("version_number")
  layoutJson    Json     @map("layout_json")
  note          String?  @db.Text
  savedAt       DateTime @default(now()) @map("saved_at")
  savedById     String?  @map("saved_by_id") @db.Uuid

  // Relations
  floorPlan FloorPlan   @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  savedBy   Membership? @relation("FloorPlanVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)

  @@unique([floorPlanId, versionNumber])
  @@index([floorPlanId, versionNumber(sort: Desc)])
  @@map("floor_plan_versions")
}

model Section {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floorPlanId   String   @map("floor_plan_id") @db.Uuid
  name          String   @db.VarChar(100)
  color         String   @default("#3B82F6") @db.VarChar(7)
  displayOrder  Int      @default(0) @map("display_order")
  polygonJson   Json?    @map("polygon_json")
  revenueCenter String?  @map("revenue_center") @db.VarChar(50)
  minPartySize  Int?     @map("min_party_size")
  maxPartySize  Int?     @map("max_party_size")
  isBookable    Boolean  @default(true) @map("is_bookable")
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  floorPlan               FloorPlan                 @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  tables                  Table[]
  guestProfilePreferences GuestProfile[]            @relation("GuestPreferredSection")
  waitlistPreferences     WaitlistEntry[]
  serverAssignments       ServerSectionAssignment[]
  mediaItems              MediaItem[]

  @@index([floorPlanId, displayOrder])
  @@map("sections")
}

model GuestProfile {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // Identity
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(30)
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)

  // Visit history
  visitCount        Int       @default(0) @map("visit_count")
  lastVisitAt       DateTime? @map("last_visit_at")
  firstVisitAt      DateTime? @map("first_visit_at")
  lifetimeSpend     Int       @default(0) @map("lifetime_spend") // cents
  averageSpend      Int       @default(0) @map("average_spend") // cents
  noShowCount       Int       @default(0) @map("no_show_count")
  cancellationCount Int       @default(0) @map("cancellation_count")

  // Preferences
  favoriteServerId    String?  @map("favorite_server_id") @db.Uuid
  preferredSectionId  String?  @map("preferred_section_id") @db.Uuid
  dietaryRestrictions String[] @map("dietary_restrictions") @db.VarChar(255)
  allergies           String[] @db.VarChar(255)
  alcoholPreferences  String[] @map("alcohol_preferences") @db.VarChar(255)
  specialOccasions    Json?    @map("special_occasions")
  notes               String?  @db.Text
  tags                String[] @default([]) @db.VarChar(50)
  vipTier             Int      @default(0) @map("vip_tier")

  // Marketing opt-ins
  optInMarketing Boolean @default(false) @map("opt_in_marketing")
  optInWhatsapp  Boolean @default(false) @map("opt_in_whatsapp")
  optInSms       Boolean @default(false) @map("opt_in_sms")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  favoriteServer   Membership?         @relation("GuestFavoriteServer", fields: [favoriteServerId], references: [id], onDelete: SetNull)
  preferredSection Section?            @relation("GuestPreferredSection", fields: [preferredSectionId], references: [id], onDelete: SetNull)
  reservations     Reservation[]
  waitlistEntries  WaitlistEntry[]
  arrivalEvents    GuestArrivalEvent[]

  @@index([tenantId, lastVisitAt(sort: Desc)])
  @@index([tenantId, visitCount(sort: Desc)])
  @@map("guest_profiles")
}

model Reservation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  tableId        String? @map("table_id") @db.Uuid
  guestProfileId String? @map("guest_profile_id") @db.Uuid

  // Snapshot
  customerName  String  @map("customer_name") @db.VarChar(200)
  customerPhone String? @map("customer_phone") @db.VarChar(30)
  customerEmail String? @map("customer_email") @db.VarChar(255)
  partySize     Int     @map("party_size")

  // Time
  bookedFor                DateTime  @map("booked_for")
  estimatedDurationMinutes Int       @default(90) @map("estimated_duration_minutes")
  holdExpiresAt            DateTime? @map("hold_expires_at")

  // Status
  status ReservationStatus @default(CONFIRMED)
  source ReservationSource @default(WEBSITE)

  // Context
  specialOccasion String?  @map("special_occasion") @db.VarChar(50)
  notes           String?  @db.Text
  internalNotes   String?  @map("internal_notes") @db.Text
  guestTags       String[] @default([]) @map("guest_tags") @db.VarChar(50)

  // Money
  depositAmount          Int?    @map("deposit_amount")
  depositStatus          String? @map("deposit_status") @db.VarChar(20)
  depositPaymentId       String? @map("deposit_payment_id") @db.VarChar(100)
  cancellationFeeAmount  Int?    @map("cancellation_fee_amount")
  cancellationFeeCharged Boolean @default(false) @map("cancellation_fee_charged")
  cardOnFileToken        String? @map("card_on_file_token") @db.VarChar(255)

  // Communications
  confirmationSentAt DateTime? @map("confirmation_sent_at")
  reminderSentAt     DateTime? @map("reminder_sent_at")
  // Phase 5d (2026-05-18): split reminder tracking for 24h vs 2h windows
  reminder24hSentAt  DateTime? @map("reminder_24h_sent_at")
  reminder2hSentAt   DateTime? @map("reminder_2h_sent_at")
  // Phase E R4 (2026-07-31): align on 24h/12h/4h across appointments +
  // reservations. Legacy 2h column above stays for backfill compat.
  reminder12hSentAt  DateTime? @map("reminder_12h_sent_at")
  reminder4hSentAt   DateTime? @map("reminder_4h_sent_at")
  whatsappThreadId   String?   @map("whatsapp_thread_id") @db.VarChar(100)

  // State transitions
  arrivedAt       DateTime? @map("arrived_at")
  seatedAt        DateTime? @map("seated_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason") @db.VarChar(255)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id") @db.Uuid

  // Relations
  location      Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table         Table?              @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestProfile  GuestProfile?       @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  createdBy     Membership?         @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  arrivalEvents GuestArrivalEvent[]

  @@index([locationId, bookedFor])
  @@index([tableId])
  @@index([guestProfileId])
  @@index([locationId, status])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  ARRIVED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ReservationSource {
  WEBSITE
  GOOGLE
  PHONE
  WALK_IN
  WHATSAPP
  PARTNER
  INTERNAL
}

model WaitlistEntry {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId     String  @map("location_id") @db.Uuid
  guestProfileId String? @map("guest_profile_id") @db.Uuid

  customerName       String  @map("customer_name") @db.VarChar(200)
  customerPhone      String  @map("customer_phone") @db.VarChar(30)
  partySize          Int     @map("party_size")
  preferredArea      String? @map("preferred_area") @db.VarChar(50)
  preferredSectionId String? @map("preferred_section_id") @db.Uuid

  // Quote
  quotedWaitMinutes  Int       @map("quoted_wait_minutes")
  estimatedSeatingAt DateTime? @map("estimated_seating_at")

  // SMS flow
  smsSentAt     DateTime? @map("sms_sent_at")
  smsReplyAt    DateTime? @map("sms_reply_at")
  smsReplyValue String?   @map("sms_reply_value") @db.VarChar(10)

  // Pre-auth tab (Toast pattern)
  preAuthCardToken String? @map("pre_auth_card_token") @db.VarChar(255)
  preAuthAmount    Int?    @map("pre_auth_amount")

  status          WaitlistStatus @default(WAITING)
  seatedAtTableId String?        @map("seated_at_table_id") @db.Uuid
  seatedAt        DateTime?      @map("seated_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  location         Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  guestProfile     GuestProfile?       @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  preferredSection Section?            @relation(fields: [preferredSectionId], references: [id], onDelete: SetNull)
  seatedAtTable    Table?              @relation(fields: [seatedAtTableId], references: [id], onDelete: SetNull)
  arrivalEvents    GuestArrivalEvent[]

  @@index([locationId, status, createdAt])
  @@map("waitlist_entries")
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  SEATED
  NO_SHOW
  CANCELLED
}

// ============================================================================
// APPOINTMENTS — Phase E R1 (2026-07-31)
//
// Location business hours already live on Location.operatingHours (JSON,
// reused from the reservation availability engine). NOT duplicated here.
//
// Staff schedules: per-technician per-day-of-week working hours. Missing
// row = tech follows location business hours. Rows with null start/end =
// tech doesn't work that day.
//
// Time off: full-day off ranges (vacation, sick day, personal). Both
// dates inclusive.
//
// Together these feed the availability engine (src/lib/appointment-
// availability.ts) which returns free slots given date + services + tech.
// ============================================================================

model StaffSchedule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  startTime    String?  @map("start_time") @db.VarChar(5)
  endTime      String?  @map("end_time") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dayOfWeek])
  @@index([membershipId])
  @@map("staff_schedules")
}

model StaffTimeOff {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  // Both dates inclusive. Single day off → startDate == endDate.
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  reason       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, startDate, endDate])
  @@map("staff_time_off")
}

model SectionTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  name       String   @db.VarChar(100)
  dayOfWeek  Int?     @map("day_of_week") // 0..6, null = any day
  shiftLabel String?  @map("shift_label") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  location    Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignments ServerSectionAssignment[]

  @@index([locationId])
  @@map("section_templates")
}

model ServerSectionAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  templateId     String?   @map("template_id") @db.Uuid
  shiftDate      DateTime? @map("shift_date") @db.Date
  shiftStartTime String?   @map("shift_start_time") // 'HH:MM' time as string for simplicity
  shiftEndTime   String?   @map("shift_end_time")
  sectionId      String    @map("section_id") @db.Uuid
  serverId       String    @map("server_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  location Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template SectionTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  server   Membership       @relation("ServerSectionAssignment", fields: [serverId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([locationId, shiftDate])
  @@index([serverId])
  @@map("server_section_assignments")
}

model SpecialDate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  date              DateTime @db.Date
  label             String   @db.VarChar(100)
  blockReservations Boolean  @default(false) @map("block_reservations")
  blockWalkins      Boolean  @default(false) @map("block_walkins")
  blockOnline       Boolean  @default(false) @map("block_online")
  customOpenTime    String?  @map("custom_open_time") // 'HH:MM'
  customCloseTime   String?  @map("custom_close_time")
  publicMessage     String?  @map("public_message") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@map("special_dates")
}

model GuestArrivalEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  arrivedAt  DateTime @default(now()) @map("arrived_at")

  partySize Int?          @map("party_size")
  source    ArrivalSource @default(MANUAL)

  reservationId   String? @map("reservation_id") @db.Uuid
  waitlistEntryId String? @map("waitlist_entry_id") @db.Uuid
  guestProfileId  String? @map("guest_profile_id") @db.Uuid

  // Camera-specific (future use)
  cameraId             String? @map("camera_id") @db.VarChar(100)
  detectionConfidence  Float?  @map("detection_confidence")
  faceRecognitionScore Float?  @map("face_recognition_score")
  rawPayload           Json?   @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  guestProfile  GuestProfile?  @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([locationId, arrivedAt(sort: Desc)])
  @@index([reservationId])
  @@index([waitlistEntryId])
  @@map("guest_arrival_events")
}

enum ArrivalSource {
  MANUAL
  CAMERA
  QR_SCAN
  WHATSAPP
  RESERVATION
}

model UploadedFile {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  s3Bucket    String  @map("s3_bucket") @db.VarChar(255)
  s3Key       String  @map("s3_key") @db.VarChar(500)
  s3Etag      String? @map("s3_etag") @db.VarChar(100)
  s3VersionId String? @map("s3_version_id") @db.VarChar(100)

  filename  String @db.VarChar(255)
  mimeType  String @map("mime_type") @db.VarChar(100)
  sizeBytes BigInt @map("size_bytes")
  widthPx   Int?   @map("width_px")
  heightPx  Int?   @map("height_px")

  resourceType String  @map("resource_type") @db.VarChar(50)
  resourceId   String? @map("resource_id") @db.Uuid
  isPublic     Boolean @default(true) @map("is_public")

  uploadStatus String    @default("PENDING") @map("upload_status") @db.VarChar(20)
  uploadedAt   DateTime? @map("uploaded_at")
  deletedAt    DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy Membership? @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([s3Bucket, s3Key])
  @@index([tenantId, resourceType])
  @@index([resourceType, resourceId])
  @@map("uploaded_files")
}

// ============================================================================
// SECTION 15: RESTAURANT MEDIA  (Phase 3b, 2026-05-18)
// ============================================================================
//
// Per-location media library: photos, videos, 360° panoramas.
// Surfaces in: admin gallery (manage), customer reservation page (Phase 6),
// virtual tour viewer (Phase 3c, panoramas become scenes).

model MediaItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  sectionId  String? @map("section_id") @db.Uuid
  // null = applies to whole location
  // set = section-specific gallery (e.g. "Patio" only)

  mediaType       MediaType @map("media_type")
  s3Key           String    @map("s3_key") @db.VarChar(500)
  publicUrl       String    @map("public_url") @db.VarChar(800)
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(800)
  fileSizeBytes   BigInt?   @map("file_size_bytes")
  widthPx         Int?      @map("width_px")
  heightPx        Int?      @map("height_px")
  durationSeconds Int?      @map("duration_seconds")

  caption      String? @db.VarChar(500)
  altText      String? @map("alt_text") @db.VarChar(500)
  displayOrder Int     @default(0) @map("display_order")
  isCover      Boolean @default(false) @map("is_cover")

  // 360° panorama specific
  sceneName      String? @map("scene_name") @db.VarChar(100)
  initialYaw     Float?  @default(0) @map("initial_yaw")
  initialPitch   Float?  @default(0) @map("initial_pitch")
  initialFov     Float?  @default(90) @map("initial_fov")
  // Phase 3c (2026-05-18): one default scene per location starts the tour
  isDefaultScene Boolean @default(false) @map("is_default_scene")

  isActive     Boolean @default(true) @map("is_active")
  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  location         Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  section          Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  uploadedBy       Membership?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  // Phase 3c (2026-05-18): hotspots placed on this 360° scene
  hotspots         TourHotspot[] @relation("SceneHotspots")
  // Hotspots that TARGET this scene (back-reference)
  incomingHotspots TourHotspot[] @relation("HotspotTargetScene")

  @@index([locationId, displayOrder])
  @@index([sectionId])
  @@index([locationId, mediaType])
  @@map("media_items")
}

enum MediaType {
  PHOTO
  VIDEO
  PANORAMA_360
}

// ============================================================================
// SECTION 16: VIRTUAL TOUR  (Phase 3c, 2026-05-18)
// ============================================================================
//
// Hotspots placed inside 360° panoramas. Powers the Zillow-style virtual
// tour where customers can:
//   - Walk between scenes (SCENE_LINK)
//   - Click a table to book it (TABLE_LINK)
//   - Read info popups (INFO)
//   - Open external links like menu PDFs (EXTERNAL_URL)

model TourHotspot {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sceneMediaId String @map("scene_media_id") @db.Uuid

  hotspotType HotspotType @map("hotspot_type")

  // Position in spherical coordinates (Pannellum convention)
  yaw   Float // -180..180 horizontal angle
  pitch Float // -90..90 vertical angle

  // Display
  label   String  @db.VarChar(200)
  iconUrl String? @map("icon_url") @db.VarChar(500)

  // Targets — only one populated depending on hotspotType (CHECK constraint in DB)
  targetSceneMediaId String? @map("target_scene_media_id") @db.Uuid
  targetTableId      String? @map("target_table_id") @db.Uuid
  externalUrl        String? @map("external_url") @db.VarChar(800)

  // For SCENE_LINK — where to look when arriving at the target scene
  targetYaw   Float? @map("target_yaw")
  targetPitch Float? @map("target_pitch")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  scene       MediaItem  @relation("SceneHotspots", fields: [sceneMediaId], references: [id], onDelete: Cascade)
  targetScene MediaItem? @relation("HotspotTargetScene", fields: [targetSceneMediaId], references: [id], onDelete: SetNull)
  targetTable Table?     @relation("HotspotTargetTable", fields: [targetTableId], references: [id], onDelete: SetNull)

  @@index([sceneMediaId])
  @@index([targetSceneMediaId])
  @@index([targetTableId])
  @@map("tour_hotspots")
}

enum HotspotType {
  SCENE_LINK
  TABLE_LINK
  INFO
  EXTERNAL_URL
}

// ============================================
// SECTION 25: CONVERSATION INBOX (Phase 5d, 2026-05-18)
// ============================================
// All inbound SMS / WhatsApp messages that don't match a waitlist 1/9 reply
// land here. Staff can view + respond from admin portal (UI in future phase).
// Schema ships in Phase 5d so we capture data from day one.
// ============================================================

model ConversationMessage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  locationId    String?   @map("location_id") @db.Uuid
  channel       String    @db.VarChar(20) // 'SMS' | 'WHATSAPP'
  direction     String    @db.VarChar(10) // 'INBOUND' | 'OUTBOUND'
  fromPhone     String    @map("from_phone") @db.VarChar(30)
  toPhone       String    @map("to_phone") @db.VarChar(30)
  body          String?   @db.Text
  providerMsgId String?   @map("provider_msg_id") @db.VarChar(255)
  relatedKind   String?   @map("related_kind") @db.VarChar(30) // 'waitlist' | 'reservation' | null
  relatedId     String?   @map("related_id") @db.Uuid
  rawPayload    Json?     @map("raw_payload")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_conv_msgs_tenant_created")
  @@index([fromPhone, toPhone], map: "idx_conv_msgs_phone")
  @@map("conversation_messages")
}

// ============================================================================
// SUPPLIER MARKETPLACE — Phase 8 (2026-07-30)
// ============================================================================
// A supplier is a Tenant with businessType='supplier'. Only supplier tenants
// have a SupplierProfile row (one-to-one). Merchants and suppliers are linked
// through SupplierMerchantRelationship rows — created either from an accepted
// SupplierInvite (merchant found the supplier first) or from a merchant
// clicking "connect" on a publicly-listed supplier in the marketplace.
//
// Catalog + orders + payment gateway credentials arrive in Phases B/C.
// ============================================================================

enum SupplierInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum SupplierRelationshipStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum SupplierRelationshipSource {
  INVITE // merchant invited the supplier, supplier accepted
  MARKETPLACE // merchant discovered a public supplier and connected
}

// Onboarding funnel for a supplier tenant. Drives the supplier portal's
// dashboard "next step" tile. NEW = just signed up. CATALOG_SETUP = has
// a profile but hasn't uploaded products yet. GATEWAY_PENDING = catalog
// exists, waiting on payment-gateway approval. ACTIVE = fully live.
enum SupplierOnboardingStatus {
  NEW
  CATALOG_SETUP
  GATEWAY_PENDING
  ACTIVE
  SUSPENDED
}

model SupplierProfile {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // Company info — a supplier is a real business; these fields are what
  // shows up on merchant-facing profile pages and on payment gateway leads.
  legalName    String? @map("legal_name") @db.VarChar(255)
  displayName  String? @map("display_name") @db.VarChar(255)
  websiteUrl   String? @map("website_url") @db.VarChar(500)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(30)
  aboutText    String? @map("about_text") @db.Text

  // Warehouse / shipping origin. Stored as JSON so we don't have to redesign
  // the schema when we later add lat/lng or multiple warehouses.
  warehouseAddress Json? @map("warehouse_address")

  // Categories the supplier serves — free-text tags for now. Later we'll
  // migrate to a normalized taxonomy for browsing/filtering the marketplace.
  categories String[] @default([])

  // Business rules
  minOrderCents       Int    @default(0) @map("min_order_cents")
  defaultLeadDays     Int    @default(3) @map("default_lead_days")
  // Phase D #75 (2026-07-31): default payment terms — days after PO
  // submission before the balance is considered "due". 30 = Net 30
  // (industry standard). Set to 0 for cash-on-delivery.
  defaultNetTermsDays Int    @default(30) @map("default_net_terms_days")
  currency            String @default("CAD") @db.VarChar(3)

  // Marketplace visibility. When false, only merchants who invited this
  // supplier can see the catalog. When true, the supplier is listed publicly
  // in the marketplace for any merchant to find.
  isPublic Boolean @default(false) @map("is_public")

  // Funnel state — the dashboard uses this to show the "next step" tile.
  onboardingStatus SupplierOnboardingStatus @default(NEW) @map("onboarding_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isPublic])
  @@index([onboardingStatus])
  @@map("supplier_profiles")
}

model SupplierInvite {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Merchant tenant sending the invite.
  fromTenantId     String  @map("from_tenant_id") @db.Uuid
  // Who on the merchant side clicked "invite" — audit trail. Nullable in case
  // the membership is later deleted; the invite record survives.
  fromMembershipId String? @map("from_membership_id") @db.Uuid

  // Recipient info. Email is the canonical identifier — we don't require the
  // supplier to have an account yet.
  email       String  @db.VarChar(255)
  companyName String? @map("company_name") @db.VarChar(255)
  contactName String? @map("contact_name") @db.VarChar(100)
  phone       String? @db.VarChar(30)
  message     String? @db.Text

  // Cryptographic token in the invite link; single-use. Indexed unique so
  // the accept endpoint can look it up in O(1) without exposing the invite id.
  token String @unique @db.VarChar(64)

  status     SupplierInviteStatus @default(PENDING)
  expiresAt  DateTime             @map("expires_at")
  acceptedAt DateTime?            @map("accepted_at")

  // Once accepted, we know which supplier tenant was created (or which
  // existing supplier tenant linked in). Null until acceptance.
  acceptedTenantId String? @map("accepted_tenant_id") @db.Uuid

  // If the invite was created FROM an existing local Supplier row on the
  // merchant's inventory list, this points back to it. On acceptance we
  // update that Supplier.linkedTenantId to the new supplier tenant.
  localSupplierId String? @map("local_supplier_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromTenant Tenant @relation("SupplierInvitesFromMerchant", fields: [fromTenantId], references: [id], onDelete: Cascade)

  @@index([fromTenantId, status])
  @@index([email])
  @@map("supplier_invites")
}

model SupplierMerchantRelationship {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The supplier's tenant (businessType='supplier').
  supplierTenantId String @map("supplier_tenant_id") @db.Uuid
  // The merchant's tenant (restaurant/retail/salon/etc.).
  merchantTenantId String @map("merchant_tenant_id") @db.Uuid

  status   SupplierRelationshipStatus @default(ACTIVE)
  source   SupplierRelationshipSource @default(INVITE)
  // If this relationship was created via an accepted invite, keep the pointer
  // for audit/analytics. Null when the merchant discovered the supplier
  // through the public marketplace.
  inviteId String?                    @map("invite_id") @db.Uuid

  // Denormalized stats for fast dashboard tiles. Kept up-to-date by the PO
  // service in Phase B (fire-and-forget after each PO lifecycle event).
  firstOrderAt    DateTime? @map("first_order_at")
  lastOrderAt     DateTime? @map("last_order_at")
  totalOrders     Int       @default(0) @map("total_orders")
  totalSpentCents Int       @default(0) @map("total_spent_cents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierTenant Tenant @relation("RelationshipSupplierSide", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  merchantTenant Tenant @relation("RelationshipMerchantSide", fields: [merchantTenantId], references: [id], onDelete: Cascade)

  // A merchant can only have ONE relationship row per supplier. If they
  // pause/terminate and want to reconnect, flip status back to ACTIVE
  // rather than creating a second row.
  // Purchase orders under this relationship. Optional linkage — POs also
  // carry supplierTenantId + merchantTenantId directly, so this is really
  // a convenience for "show all POs with this partner" queries.
  purchaseOrders PurchaseOrder[]

  @@unique([supplierTenantId, merchantTenantId])
  @@index([supplierTenantId, status])
  @@index([merchantTenantId, status])
  @@map("supplier_merchant_relationships")
}

// ============================================================================
// SUPPLIER CATALOG — Phase B (2026-07-30)
// ============================================================================
// Products, categories, and images owned by a supplier tenant. Kept separate
// from the merchant-side Product/Category models on purpose:
//   - Suppliers price in wholesale, not retail
//   - They have min-order quantities and lead times
//   - They may go public in the marketplace where merchants they've never
//     met can see them
// Same-table reuse would have required nullable columns for half the fields
// AND polluted queries on both sides. Two clean models > one messy one.
// ============================================================================

model SupplierProductCategory {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierTenantId String @map("supplier_tenant_id") @db.Uuid

  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierTenant Tenant            @relation(fields: [supplierTenantId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]

  // A supplier can't have two categories with the same name — cheap DB-level
  // guard against accidental duplication via bulk import.
  @@unique([supplierTenantId, name])
  @@index([supplierTenantId, isActive])
  @@map("supplier_product_categories")
}

model SupplierProduct {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierTenantId String  @map("supplier_tenant_id") @db.Uuid
  categoryId       String? @map("category_id") @db.Uuid

  // Identifiers
  sku     String? @db.VarChar(64) // Supplier's own SKU (optional but recommended)
  barcode String? @db.VarChar(64) // UPC/EAN if applicable

  // Basic info
  name        String  @db.VarChar(255)
  description String? @db.Text

  // Unit & packaging. `unitLabel` is what the merchant sees in the cart
  // ("20kg box", "case of 24") — no unit conversion in v1, just a label.
  unitLabel String @default("unit") @map("unit_label") @db.VarChar(50)

  // Pricing in cents. wholesalePriceCents is what the merchant pays.
  // retailPriceCents is an optional reference price the supplier can show
  // ("MSRP $50") to justify the wholesale ask.
  wholesalePriceCents Int  @map("wholesale_price_cents")
  retailPriceCents    Int? @map("retail_price_cents")

  // Order rules — enforced at PO creation, not at display.
  minOrderQty Int @default(1) @map("min_order_qty")
  stepQty     Int @default(1) @map("step_qty")

  // Inventory. All three fields are optional — a supplier who doesn't
  // want to track stock leaves them null and the product is always
  // orderable. When trackInventory=true the PO flow decrements stockLevel
  // on delivery and low_stock_threshold drives the supplier's alerts.
  trackInventory    Boolean @default(false) @map("track_inventory")
  stockLevel        Int?    @map("stock_level")
  lowStockThreshold Int?    @map("low_stock_threshold")

  // Overrides for the supplier-profile defaults. leadTimeDays lets a
  // hard-to-source item advertise a longer lead than the supplier default.
  leadTimeDays Int? @map("lead_time_days")

  // Visibility. isPublic gates listing in the public marketplace when the
  // supplier's own profile.isPublic is also true. isActive is a soft-delete
  // toggle — set false to hide from EVERYONE including invited merchants
  // without losing history.
  isPublic Boolean @default(false) @map("is_public")
  isActive Boolean @default(true) @map("is_active")

  sortOrder Int @default(0) @map("sort_order")

  // Phase D #70 (2026-07-30): variant axes. Empty = simple product (sold
  // as-is, stock/price on this row). Non-empty = product has variants —
  // each combination lives in SupplierProductVariant. Axis names are
  // arbitrary: ["Weight", "Format"] for cheese, ["Size", "Color"] for
  // shirts, ["Vintage", "Bottle Size"] for wine.
  //
  // When variants exist, the product-level wholesalePriceCents / stockLevel /
  // minOrderQty / stepQty become the DEFAULTS variants inherit if not
  // overridden. Merchant orders reference a specific variantId.
  variantAxes String[] @default([]) @map("variant_axes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierTenant          Tenant                     @relation(fields: [supplierTenantId], references: [id], onDelete: Cascade)
  category                SupplierProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                  SupplierProductImage[]
  variants                SupplierProductVariant[]
  // Phase D #73 (2026-07-30): volume-tier pricing on simple products.
  // For products WITH variants, tiers live on the variant rows instead.
  priceTiers              SupplierProductPriceTier[]
  // PO line items referencing this product. On delete we SET NULL rather
  // than cascade — line items keep their frozen name/price/SKU snapshot,
  // just lose the live link back to the (deleted) product.
  purchaseOrderItems      PurchaseOrderItem[]
  // Phase D #77 (2026-07-31): merchant Ingredients that name this product
  // as their preferred restock source. Back-ref for
  // Ingredient.preferredSupplierProductId.
  preferredForIngredients Ingredient[]               @relation("IngredientPreferredSupplierProduct")

  // SKU is unique per supplier when set (nullable — some catalogs don't
  // have SKUs). Partial unique index in SQL because Prisma can't express
  // "unique WHERE NOT NULL"; enforced there.
  @@index([supplierTenantId, isActive])
  @@index([supplierTenantId, categoryId])
  @@index([supplierTenantId, isPublic])
  @@map("supplier_products")
}

// One row per image on a supplier product. Separate table (rather than a
// JSON array on SupplierProduct) so we can:
//   1. Reorder / delete individual images without rewriting the whole product
//   2. Avoid loading base64 image data when just listing product names/prices
//   3. Later move to S3 keys without touching the product model
//
// `dataUrl` is Text so it can hold either a base64 data URL (Phase B v1)
// or an S3 URL (later).
model SupplierProductImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid

  dataUrl   String  @map("data_url") @db.Text
  altText   String? @map("alt_text") @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  product SupplierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("supplier_product_images")
}

// Phase D #70 (2026-07-30): product variants.
//
// A variant is one point in the N-dimensional space defined by the
// parent product's `variantAxes`. Example:
//   product.variantAxes = ["Weight", "Format"]
//   variant #1: attributes = { "Weight": "1kg",  "Format": "Block" }
//   variant #2: attributes = { "Weight": "1kg",  "Format": "Grated" }
//   variant #3: attributes = { "Weight": "20kg", "Format": "Block" }
//
// `attributes` shape is deliberately unconstrained JSON — the axis names
// are whatever the supplier types, and the values are free-form strings.
// The consuming UI derives `displayName` for merchants ("1kg · Block").
//
// Every price/stock/order-rule field is NULLABLE — leaving it null means
// "inherit from the parent product". This lets a supplier bulk-set price
// on the product and only override on variants that differ.
model SupplierProductVariant {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid

  // Merchant-facing label. Auto-derived from `attributes` when saved
  // ("1kg · Block") but stored so future axis-rename doesn't break
  // historical PO line items that reference this variant.
  displayName String @map("display_name") @db.VarChar(255)

  // Free-form JSON: { axisName: value } for every axis on the parent
  // product. Validated at write time against product.variantAxes.
  attributes Json

  // Per-variant SKU + barcode. SKU unique per PARENT product when set.
  sku     String? @db.VarChar(64)
  barcode String? @db.VarChar(64)

  // All pricing/stock/order-rule overrides — null = inherit from product.
  wholesalePriceCents Int?    @map("wholesale_price_cents")
  retailPriceCents    Int?    @map("retail_price_cents")
  minOrderQty         Int?    @map("min_order_qty")
  stepQty             Int?    @map("step_qty")
  trackInventory      Boolean @default(false) @map("track_inventory")
  stockLevel          Int?    @map("stock_level")
  lowStockThreshold   Int?    @map("low_stock_threshold")

  // Optional per-variant image. Falls back to the parent product's
  // primary image when null. Base64 data URL, same pattern as
  // SupplierProductImage.dataUrl.
  imageDataUrl String? @map("image_data_url") @db.Text

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product            SupplierProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  // Phase D #73 (2026-07-30): per-variant volume tiers.
  priceTiers         SupplierProductPriceTier[]

  // SKU unique per product when set. Partial unique index in SQL because
  // Prisma can't express "unique WHERE NOT NULL" natively.
  @@index([productId, isActive])
  @@map("supplier_product_variants")
}

// Phase D #73 (2026-07-30): volume-tier pricing.
//
// A tier says "at qty ≥ minQty, unit price becomes unitPriceCents".
// Attached to EITHER a product (simple product with no variants) OR a
// variant — exactly one of productId/variantId is set. Enforced by a
// CHECK constraint in SQL because Prisma can't express XOR in the model.
//
// Resolution at order time: pick the tier with the HIGHEST minQty ≤ qty.
// If no tier applies, fall back to the product/variant default price.
// See src/lib/supplier-price-tiers.ts for the resolver.
model SupplierProductPriceTier {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String? @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  minQty         Int @map("min_qty")
  unitPriceCents Int @map("unit_price_cents")

  createdAt DateTime @default(now()) @map("created_at")

  product SupplierProduct?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant SupplierProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, minQty])
  @@index([variantId, minQty])
  @@map("supplier_product_price_tiers")
}

// Phase D #74 (2026-07-30): in-app messaging per PO.
//
// Simple two-party chat scoped to a single PO. `senderSide` is the
// canonical MERCHANT/SUPPLIER identity — cheaper than joining back
// through membership → tenant on every render, and durable if the
// membership row is deleted later.
//
// Read state is per-SIDE, not per-user: when a user on side A opens the
// thread, we mark every message from side B as read (fills
// `readByOtherSideAt`). Fine for B2B where each side is essentially
// one voice. Per-user read receipts would need a separate table.
enum PoMessageSide {
  MERCHANT
  SUPPLIER
}

model PurchaseOrderMessage {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid

  senderSide         PoMessageSide @map("sender_side")
  // Nullable — a deleted membership shouldn't wipe the message. `senderName`
  // snapshot preserves attribution.
  senderMembershipId String?       @map("sender_membership_id") @db.Uuid
  senderName         String?       @map("sender_name") @db.VarChar(150)

  body String @db.Text

  // Filled when the OTHER side opens the thread — drives unread badges
  // on both the order-list rows and the message chip on PO detail.
  readByOtherSideAt DateTime? @map("read_by_other_side_at")

  createdAt DateTime @default(now()) @map("created_at")

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  senderMembership Membership?   @relation("PoMessageSender", fields: [senderMembershipId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId, createdAt])
  // Fast "unread count for me" query: WHERE purchaseOrderId=X AND senderSide=OTHER AND readByOtherSideAt IS NULL
  @@index([purchaseOrderId, senderSide, readByOtherSideAt])
  @@map("purchase_order_messages")
}

// ============================================================================
// PURCHASE ORDERS — Phase B (2026-07-30)
// ============================================================================
// A merchant creates a PO addressed to one supplier. Line items snapshot
// the product name, SKU, unit label, and unit price at submit time — so a
// supplier can rename or delete a product without the PO's history changing.
//
// Status flow (linear except CANCELLED can happen from any non-terminal
// state; there is no DRAFT — the merchant's in-progress cart lives in
// localStorage, never in the DB):
//
//     SUBMITTED ──> ACKNOWLEDGED ──> SHIPPED ──> DELIVERED
//         │              │             │
//         └──────────────┴─────────────┴──> CANCELLED
//
// Timestamps live on the PO row (submittedAt / acknowledgedAt / etc.)
// rather than in a separate events table — enough for the reports we
// need in Phase B. A proper audit-log table can be added in Phase C.
// ============================================================================

enum PurchaseOrderStatus {
  SUBMITTED
  ACKNOWLEDGED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ============================================================================
// SUPPLIER WAREHOUSE — Phase D #76 (2026-07-31)
//
// A fulfillment origin the supplier ships from. Regional distributors
// typically have 2–4 (Toronto DC, Montreal Cold Storage, Vancouver
// hub); single-location suppliers just have one row marked isDefault.
//
// Merchants see which warehouse their PO is coming from — useful for
// transit-time estimation and pick-up scenarios. Assignment happens at
// PO acknowledgement (supplier picks); the default warehouse is used
// when the supplier doesn't override.
//
// v1 is passive routing (supplier picks). v2 will auto-assign based on
// merchant location vs. servesRegions.
// ============================================================================

model SupplierWarehouse {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierTenantId String @map("supplier_tenant_id") @db.Uuid

  name       String  @db.VarChar(120) // "Toronto DC"
  address    String  @db.Text
  city       String? @db.VarChar(120)
  province   String? @db.VarChar(120)
  postalCode String? @map("postal_code") @db.VarChar(20)
  country    String  @default("CA") @db.VarChar(2)
  phone      String? @db.VarChar(30)

  // Regions this warehouse serves. Empty array = serves ALL regions
  // (typical for the default warehouse). Populated arrays gate the
  // (future) auto-router.
  servesRegions String[] @default([]) @map("serves_regions")

  // At most one default per supplier — enforced by partial unique index
  // in SQL, since Prisma can't express that.
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  notes     String? @db.Text // hours, PO instructions, etc.
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierTenant Tenant          @relation("SupplierWarehouses", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[] @relation("PoWarehouse")

  @@unique([supplierTenantId, name])
  @@index([supplierTenantId, isActive])
  @@map("supplier_warehouses")
}

// Phase C #67 (2026-07-30): payment lifecycle on a PO. Independent from
// the fulfillment status — a PO can be PAID before it's SHIPPED, or PAID
// after it's DELIVERED, depending on merchant/supplier terms.
//
// Renamed from `PaymentStatus` → `POPaymentStatus` to avoid a name
// collision with the pre-existing `PaymentStatus` enum on the merchant
// Payment/Order tables (different lifecycle semantics — that one is for
// POS-side payment records; this one is B2B purchase orders).
enum POPaymentStatus {
  UNPAID // No link generated, or generated but not attempted yet
  PENDING // Merchant clicked the link, processor is processing
  PAID // Processor confirmed capture via webhook
  FAILED // Processor rejected (card declined, expired, etc.)
  REFUNDED // Payment reversed after capture
}

model PurchaseOrder {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Parties. Both are Tenants — supplier + merchant.
  supplierTenantId   String  @map("supplier_tenant_id") @db.Uuid
  merchantTenantId   String  @map("merchant_tenant_id") @db.Uuid
  merchantLocationId String  @map("merchant_location_id") @db.Uuid
  relationshipId     String? @map("relationship_id") @db.Uuid

  // Human-readable PO number. Generated on submit — sequential per supplier,
  // format "PO-YYYY-NNNN" (e.g. "PO-2026-0042"). Unique per supplier via
  // partial unique index in SQL (skipping this in Prisma-land because
  // partial indexes aren't expressible; enforced by the migration).
  poNumber String @map("po_number") @db.VarChar(30)

  status PurchaseOrderStatus @default(SUBMITTED)

  // Money snapshot in cents. Currency snapshotted from the supplier at
  // submit time so a currency change on the supplier profile never
  // rewrites history.
  currency      String @default("CAD") @db.VarChar(3)
  subtotalCents Int    @map("subtotal_cents")
  // Taxes on B2B wholesale are messy (varies by jurisdiction, exemptions,
  // resale certs, etc.). Kept as a nullable field for now; Phase C or later
  // will fold in tax computation. Default zero means the total = subtotal.
  taxCents      Int    @default(0) @map("tax_cents")
  totalCents    Int    @map("total_cents")

  // Shipping address — snapshot of the merchant location's address at
  // submit time. JSON so we can add fields (like lat/lng) without a schema
  // change.
  shippingAddress Json @map("shipping_address")

  // Free-text notes — one from each side of the exchange.
  notesToSupplier   String? @map("notes_to_supplier") @db.Text
  notesFromSupplier String? @map("notes_from_supplier") @db.Text

  // Shipment tracking. Set by supplier when marking SHIPPED.
  shipmentCarrier     String?   @map("shipment_carrier") @db.VarChar(100)
  shipmentTrackingRef String?   @map("shipment_tracking_ref") @db.VarChar(200)
  expectedDeliveryAt  DateTime? @map("expected_delivery_at")

  // Cancellation. Both merchant and supplier can cancel; we track WHO did
  // it (for support-side auditing) and WHY (freeform reason).
  cancelledByMembershipId String? @map("cancelled_by_membership_id") @db.Uuid
  cancellationReason      String? @map("cancellation_reason") @db.Text

  // Lifecycle timestamps. submittedAt is set at row creation; the rest
  // fill in as status transitions happen.
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")
  cancelledAt    DateTime? @map("cancelled_at")

  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Phase D #77 (2026-07-31): flags POs that came from the auto-reorder
  // scanner (as opposed to a merchant clicking "Place order" manually).
  // Used to badge the row in the PO list so merchants can spot them and
  // review before the supplier acknowledges.
  autoGenerated Boolean @default(false) @map("auto_generated")

  // Phase D #76 (2026-07-31): fulfillment warehouse. Null = ships from
  // the supplier's default warehouse (or the supplier hasn't set one).
  // Supplier picks at acknowledgement; merchant only reads.
  warehouseId String?            @map("warehouse_id") @db.Uuid
  warehouse   SupplierWarehouse? @relation("PoWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  // Phase C #67 (2026-07-30): payment link + status.
  // paymentStatus is INDEPENDENT of the fulfillment status flow above —
  // a supplier can ship goods before the merchant pays, or vice versa.
  //
  // paymentLinkUrl is the processor-hosted checkout URL (GP / Moneris /
  // etc.) — we NEVER handle the card details ourselves.
  // paymentLinkReference is the processor's own transaction / order ID
  // that we use to reconcile webhook events back to this PO.
  paymentStatus          POPaymentStatus @default(UNPAID) @map("payment_status")
  paymentLinkUrl         String?         @map("payment_link_url") @db.Text
  paymentLinkReference   String?         @map("payment_link_reference") @db.VarChar(200)
  paymentLinkExpiresAt   DateTime?       @map("payment_link_expires_at")
  paymentLinkFailureNote String?         @map("payment_link_failure_note") @db.Text // set when generation fails so admin can see why
  paidAt                 DateTime?       @map("paid_at")
  paidAmountCents        Int?            @map("paid_amount_cents")
  paidMethod             String?         @map("paid_method") @db.VarChar(50)

  supplierTenant        Tenant                        @relation("PurchaseOrderSupplier", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  merchantTenant        Tenant                        @relation("PurchaseOrderMerchant", fields: [merchantTenantId], references: [id], onDelete: Cascade)
  merchantLocation      Location                      @relation("PurchaseOrderShippingLocation", fields: [merchantLocationId], references: [id], onDelete: Restrict)
  relationship          SupplierMerchantRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  createdByMembership   Membership?                   @relation("PurchaseOrderCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  cancelledByMembership Membership?                   @relation("PurchaseOrderCancelledBy", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)

  items    PurchaseOrderItem[]
  // Phase D #74 (2026-07-30): message thread between merchant + supplier
  // scoped to this specific PO.
  messages PurchaseOrderMessage[]

  @@index([supplierTenantId, status])
  @@index([merchantTenantId, status])
  @@index([merchantLocationId])
  @@index([submittedAt(sort: Desc)])
  // Fast lookup by processor reference for the webhook path (#68) —
  // webhook comes in with a transaction id, we need to find the PO.
  @@index([paymentLinkReference])
  @@map("purchase_orders")
}

// Line item on a PO. Fields prefixed `product…` are SNAPSHOTS — frozen at
// submit time, immune to later renames/deletes of the SupplierProduct.
// The live productId FK is nullable + ON DELETE SET NULL for exactly this
// reason: deleting a product must not corrupt PO history.
model PurchaseOrderItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  // Phase D #70 (2026-07-30): variant reference. Nullable both because
  // legacy line items pre-date variants, and because a simple (no-variant)
  // product's line item references the product directly with variantId=null.
  // SET NULL on delete for the same reason productId does — history stays
  // intact even if supplier removes the variant.
  variantId       String? @map("variant_id") @db.Uuid

  productSku         String? @map("product_sku") @db.VarChar(64)
  productName        String  @map("product_name") @db.VarChar(255)
  unitLabel          String  @map("unit_label") @db.VarChar(50)
  unitPriceCents     Int     @map("unit_price_cents")
  // Variant snapshot fields — frozen at PO submit, immune to later
  // supplier edits/deletes. Both null for simple-product line items.
  variantDisplayName String? @map("variant_display_name") @db.VarChar(255)
  variantAttributes  Json?   @map("variant_attributes")

  qty            Int
  lineTotalCents Int @map("line_total_cents")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       SupplierProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       SupplierProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_order_items")
}

// ============================================================================
// MERCHANT / SUPPLIER PAYMENT ONBOARDING
// Phase C (2026-07-30) — suppliers only
// Phase 2b (2026-08) — extended for merchants + granular KYB
// ============================================================================
// A tenant (supplier OR merchant) that wants to accept card payments through
// the platform fills out a MerchantApplication. Platform admin reviews it,
// forwards it as an email lead to the processor (GP / Moneris / etc.), and
// once approved records the resulting credentials in TenantPaymentProvider.
//
// tenantRole distinguishes SUPPLIER (marketplace payments — Phase C) from
// MERCHANT (POS card acceptance — Phase 2b onward). All the workflow and
// crypto is shared; only the receiving product surface differs.
//
// Sensitive KYB fields (tax id, banking, UBO ID numbers) are AES-GCM
// encrypted at rest via src/lib/kyb-crypto.ts — stored as base64 Text.
// Non-sensitive fields (legal name, address, mcc) are plaintext so the
// admin review UI can list applications without decrypting every row.
//
// UBOs / KYB documents / lifecycle events each live in their own tables
// (UboRecord, KybDocument, ApplicationEvent) so the admin UI can render
// grids without a decrypt for every row.
//
// See also: notes in kyb-crypto.ts for key management.
// ============================================================================

enum PaymentProcessor {
  GP
  MONERIS
  STRIPE
}

enum GatewayApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  FORWARDED
  INFO_REQUESTED
  PROVIDER_APPROVED
  APPROVED
  REJECTED
  LIVE
}

enum SupplierProcessorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Which product surface the applying tenant plays. Phase 2b splits merchant
// (POS card acceptance) from supplier (marketplace payments) so a single
// admin queue can serve both.
enum TenantRole {
  MERCHANT
  SUPPLIER
}

// Payment capability slot filled by a TenantPaymentProvider row. Lets a
// single tenant run e.g. GP for CARD and Moneris for INTERAC at the same
// time — the unique key is (tenantId, capability, processor).
enum TenantPaymentCapability {
  CARD
  INTERAC
  GIFT_CARD
  ACH
}

// KYB / onboarding document categories. Persisted as a Postgres enum so the
// admin UI can render fixed sections in a stable order.
enum KybDocType {
  ARTICLES_OF_INCORPORATION
  BUSINESS_LICENSE
  VOID_CHEQUE
  BANK_STATEMENT
  UBO_ID_FRONT
  UBO_ID_BACK
  UBO_PROOF_OF_ADDRESS
  DIRECTOR_ID
  TAX_RETURN
  GST_HST_REGISTRATION
  OTHER
}

enum UboIdType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
}

// Who moved an application from one state to another. actorId is the FK-ish
// pointer whose meaning depends on this discriminator (membershipId for
// MERCHANT, adminUserId for ADMIN, nullable for PROCESSOR / SYSTEM).
enum EventActorType {
  MERCHANT
  ADMIN
  PROCESSOR
  SYSTEM
}

model MerchantApplication {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // MERCHANT or SUPPLIER — decides which merchant-side wizard rendered this
  // and which admin filter surfaces it. Legacy rows backfill to SUPPLIER.
  tenantRole TenantRole @default(SUPPLIER) @map("tenant_role")

  // Optional at submit — supplier can leave blank and let the admin decide
  // which processor to route to based on volume, region, etc.
  targetProcessor PaymentProcessor? @map("target_processor")

  status GatewayApplicationStatus @default(SUBMITTED)

  // --- Business info (plaintext, not sensitive) ---
  legalName           String    @map("legal_name") @db.VarChar(255)
  dbaName             String?   @map("dba_name") @db.VarChar(255)
  businessTypeName    String?   @map("business_type_name") @db.VarChar(50) // "LLC", "Corp", "Sole Prop", etc.
  incorporationDate   DateTime? @map("incorporation_date") @db.Date
  incorporationRegion String?   @map("incorporation_region") @db.VarChar(100) // "Ontario", "Delaware", etc.
  businessAddress     Json?     @map("business_address")
  websiteUrl          String?   @map("website_url") @db.VarChar(500)
  mccCode             String?   @map("mcc_code") @db.VarChar(10)

  // --- Financial projections ---
  projectedMonthlyVolumeCents Int?   @map("projected_monthly_volume_cents")
  averageTicketCents          Int?   @map("average_ticket_cents")
  currency                    String @default("CAD") @db.VarChar(3)

  // --- Sensitive KYB (AES-GCM encrypted, base64 Text) ---
  // tax_id_enc: single string — EIN, BN, TIN, whatever the region uses.
  // bank_info_enc: JSON {accountHolderName, routingNumber, accountNumber, bankName}
  // Beneficial owners moved to UboRecord in Phase 2b (2026-08); the legacy
  // beneficial_owners_enc column is kept in the DB for one release cycle
  // for rollback, but is intentionally not exposed here.
  taxIdEnc    String? @map("tax_id_enc") @db.Text
  bankInfoEnc String? @map("bank_info_enc") @db.Text

  // --- Signer / consent (plaintext — this is the person who submits) ---
  signerName        String?   @map("signer_name") @db.VarChar(150)
  signerTitle       String?   @map("signer_title") @db.VarChar(100)
  signerEmail       String?   @map("signer_email") @db.VarChar(255)
  signerConsentedAt DateTime? @map("signer_consented_at")

  // --- Admin review fields ---
  adminNotes           String?           @map("admin_notes") @db.Text
  // Admin who last acted on the app. Recorded as email — admins aren't
  // Members of the tenant, so we don't have a membership id.
  reviewedByAdminEmail String?           @map("reviewed_by_admin_email") @db.VarChar(255)
  // Processor's onboarding-team email we sent the lead to. Useful for audit.
  forwardedToEmail     String?           @map("forwarded_to_email") @db.VarChar(255)
  // Phase 2d — extra forward bookkeeping so the timeline can show the who /
  // what / where of every "forward to processor" action.
  forwardedToProcessor PaymentProcessor? @map("forwarded_to_processor")
  forwardedByAdminId   String?           @map("forwarded_by_admin_id") @db.Uuid
  forwardBundleS3Key   String?           @map("forward_bundle_s3_key") @db.VarChar(500)
  processorMessageId   String?           @map("processor_message_id") @db.VarChar(255)
  // Processor-assigned reference once approved (e.g. GP MID).
  processorReferenceId String?           @map("processor_reference_id") @db.VarChar(100)
  rejectionReason      String?           @map("rejection_reason") @db.Text
  infoRequested        String?           @map("info_requested") @db.Text

  // --- Timestamps for each lifecycle stage ---
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  forwardedAt       DateTime? @map("forwarded_at")
  infoRequestedAt   DateTime? @map("info_requested_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")
  lastAdminActionAt DateTime? @map("last_admin_action_at")

  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByMembership Membership?            @relation("MerchantApplicationCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  // The TenantPaymentProvider row spawned by this application (if approved).
  // Nullable both ways since a rejected app never gets one.
  resultingProcessor  TenantPaymentProvider?

  // Phase 2b — granular KYB children.
  documents KybDocument[]
  ubos      UboRecord[]
  events    ApplicationEvent[]

  @@index([tenantId, status])
  @@index([status, submittedAt(sort: Desc)])
  @@index([tenantRole, status])
  @@map("merchant_applications")
}

model TenantPaymentProvider {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  applicationId String? @unique @map("application_id") @db.Uuid

  // Which payment surface this row satisfies (CARD, INTERAC, ...). Lets a
  // tenant plug in multiple processors simultaneously as long as they each
  // cover a different capability slot.
  capability TenantPaymentCapability @default(CARD)

  processor   PaymentProcessor
  externalMid String           @map("external_mid") @db.VarChar(100)

  // Encrypted JSON of API credentials — shape depends on processor:
  //   GP:      { app_id, app_key, account_name }
  //   MONERIS: { store_id, api_token }
  //   STRIPE:  { access_token, stripe_user_id }
  credentialsEnc String @map("credentials_enc") @db.Text

  // Fee schedule as JSON so we can evolve the shape without migrations.
  // Minimal expected: { percentBps: 250, fixedCents: 30 } → 2.5% + $0.30.
  feeScheduleJson Json? @map("fee_schedule_json")

  status           SupplierProcessorStatus @default(PENDING)
  activatedAt      DateTime?               @map("activated_at")
  suspendedAt      DateTime?               @map("suspended_at")
  suspensionReason String?                 @map("suspension_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application MerchantApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // One row per (tenant, capability, processor) triple. Re-onboarding after
  // suspension UPDATEs the existing row rather than inserting a new one.
  // The "only one ACTIVE per (tenant, capability)" invariant is enforced
  // by a partial unique index applied in the SQL migration (Prisma can't
  // express filtered indexes directly).
  @@unique([tenantId, capability, processor])
  @@index([tenantId, status])
  @@map("tenant_payment_providers")
}

// One uploaded onboarding document (articles of incorporation, void
// cheque, UBO ID scan, etc.). Files live in S3 — only the key + metadata
// are stored in Postgres. Rows are soft-deleted so we retain a paper
// trail (deletedAt !== null) rather than losing history.
model KybDocument {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  docType KybDocType @map("doc_type")

  // S3 object key inside the KYB bucket. Bucket + region live in env.
  s3Key            String @map("s3_key") @db.VarChar(500)
  originalFilename String @map("original_filename") @db.VarChar(255)
  mimeType         String @map("mime_type") @db.VarChar(100)
  sizeBytes        Int    @map("size_bytes")

  // SHA-256 of the file bytes — dedupe + tamper-evidence. Hex-encoded.
  sha256 String @db.VarChar(64)

  // Nullable when uploaded by an admin (adminUsers aren't Members).
  uploadedByMembershipId String? @map("uploaded_by_membership_id") @db.Uuid

  // ClamAV / equivalent hook — PENDING | CLEAN | INFECTED | ERROR. Kept as
  // VarChar rather than a Prisma enum so we can add states in Phase 2e
  // without a migration.
  scanStatus String @default("PENDING") @map("scan_status") @db.VarChar(20)

  // Soft-delete for reversibility — a mis-uploaded doc can be hidden
  // without erasing the audit trail.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application          MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedByMembership Membership?         @relation("KybDocumentUploadedBy", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)

  @@index([applicationId, docType])
  @@map("kyb_documents")
}

// Ultimate Beneficial Owner — one row per person on a MerchantApplication.
// Phase 2b decision: 10 UBOs max in the UI, unlimited in the DB.
model UboRecord {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  fullName    String   @map("full_name") @db.VarChar(150)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  nationality String   @db.VarChar(3) // ISO 3166-1 alpha-3

  // Structured JSON: { line1, line2, city, province, postalCode, country }
  residentialAddress Json @map("residential_address")

  ownershipPct Decimal @map("ownership_pct") @db.Decimal(5, 2)
  isDirector   Boolean @default(false) @map("is_director")
  isSignatory  Boolean @default(false) @map("is_signatory")

  idType           UboIdType @map("id_type")
  // AES-GCM encrypted ID number — never stored plaintext.
  idNumberEnc      String    @map("id_number_enc") @db.Text
  idExpiry         DateTime? @map("id_expiry") @db.Date
  idIssuingCountry String?   @map("id_issuing_country") @db.VarChar(3)

  sourceOfFunds String? @map("source_of_funds") @db.VarChar(200)
  isPep         Boolean @default(false) @map("is_pep") // politically exposed person

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("ubo_records")
}

// Immutable log of state transitions + admin actions on a MerchantApplication.
// Powers the Timeline tab in the admin detail view; never mutated after write.
model ApplicationEvent {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  fromStatus String? @map("from_status") @db.VarChar(30)
  toStatus   String  @map("to_status") @db.VarChar(30)

  actorType EventActorType @map("actor_type")
  // membershipId for MERCHANT actors, adminUserId for ADMIN actors; null
  // for PROCESSOR / SYSTEM events. Not a hard FK because it points into
  // different tables depending on actorType.
  actorId   String?        @map("actor_id") @db.VarChar(64)

  note String? @db.Text

  at DateTime @default(now())

  application MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@map("application_events")
}

// -----------------------------------------------------------------------
// PLATFORM ADMIN (tapapp-admin only — not used by tap-app runtime)
// -----------------------------------------------------------------------
// Separate auth surface for the operator team who runs the whole
// platform. NOT scoped to a tenant — an AdminUser sees across every
// tenant in the DB (subject to RBAC).

model AdminUser {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String          @unique @db.VarChar(255)
  firstName              String?         @map("first_name") @db.VarChar(100)
  lastName               String?         @map("last_name") @db.VarChar(100)
  passwordHash           String          @map("password_hash") @db.VarChar(255)
  role                   AdminRole       @default(SUPPORT)
  isActive               Boolean         @default(true) @map("is_active")
  mfaSecret              String?         @map("mfa_secret") @db.VarChar(128)
  lastLoginAt            DateTime?       @map("last_login_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  auditLogs              AdminAuditLog[]
  assignedSupportThreads SupportThread[] @relation("SupportAssigned")
  createdSupportThreads  SupportThread[] @relation("SupportCreated")

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  COMPLIANCE
  SUPPORT
  SALES
  FINANCE
}

model AdminAuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId  String    @map("admin_user_id") @db.Uuid
  action       String    @db.VarChar(64)
  resourceType String?   @map("resource_type") @db.VarChar(64)
  resourceId   String?   @map("resource_id") @db.VarChar(128)
  before       Json?
  after        Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("admin_audit_logs")
}

model AdminLoginAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @db.VarChar(255)
  succeeded     Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(100)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("admin_login_attempts")
}

// ============================================
// SECTION: SUPPORT CHAT (Phase 3)
// ============================================
// Three-party threads bridging admin operators, merchants (tap-app tenants),
// and suppliers (also tap-app tenants of type SUPPLIER). Merchant/supplier
// IDs are opaque UUIDs — those tenants live in tap-app's model space and
// this schema does not FK them. Admin FK uses ON DELETE SET NULL so
// removing an admin does not orphan history.

enum SupportThreadStatus {
  OPEN
  WAITING_MERCHANT
  WAITING_SUPPLIER
  WAITING_ADMIN
  RESOLVED
  CLOSED

  @@map("support_thread_status")
}

enum SupportPartyType {
  ADMIN
  MERCHANT
  SUPPLIER
  SYSTEM

  @@map("support_party_type")
}

enum SupportEntityType {
  MERCHANT_APPLICATION
  PURCHASE_ORDER
  TRANSACTION

  @@map("support_entity_type")
}

model SupportThread {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject          String              @db.VarChar(255)
  status           SupportThreadStatus @default(OPEN)
  entityType       SupportEntityType?  @map("entity_type")
  entityId         String?             @map("entity_id") @db.VarChar(128)
  merchantTenantId String?             @map("merchant_tenant_id") @db.Uuid
  supplierTenantId String?             @map("supplier_tenant_id") @db.Uuid
  createdByType    SupportPartyType    @map("created_by_type")
  createdByAdminId String?             @map("created_by_admin_id") @db.Uuid
  createdByUserId  String?             @map("created_by_user_id") @db.VarChar(128)
  createdByName    String?             @map("created_by_name") @db.VarChar(255)
  assignedAdminId  String?             @map("assigned_admin_id") @db.Uuid
  lastMessageAt    DateTime            @default(now()) @map("last_message_at")
  closedAt         DateTime?           @map("closed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  messages       SupportMessage[]
  readReceipts   SupportReadReceipt[]
  assignedAdmin  AdminUser?       @relation("SupportAssigned", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdByAdmin AdminUser?       @relation("SupportCreated", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([merchantTenantId, lastMessageAt(sort: Desc)])
  @@index([supplierTenantId, lastMessageAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([assignedAdminId])
  @@map("support_threads")
}

model SupportMessage {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId     String           @map("thread_id") @db.Uuid
  senderType   SupportPartyType @map("sender_type")
  senderId     String?          @map("sender_id") @db.VarChar(128)
  senderName   String?          @map("sender_name") @db.VarChar(255)
  body         String           @db.Text
  internalNote Boolean          @default(false) @map("internal_note")
  createdAt    DateTime         @default(now()) @map("created_at")

  thread      SupportThread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments SupportMessageAttachment[]

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// Phase 3b — attachments (private, served via presigned URLs) + per-user
// read receipts for unread badges.

model SupportMessageAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  s3Key        String   @map("s3_key") @db.Text
  fileName     String   @map("file_name") @db.VarChar(255)
  contentType  String   @map("content_type") @db.VarChar(128)
  sizeBytes    BigInt   @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  message      SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_message_attachments")
}

// Composite PK (threadId, readerType, readerId) — one row per user per
// thread. readerId is opaque so admin-user ids and tap-app user ids both
// fit without a discriminator table.
model SupportReadReceipt {
  threadId    String           @map("thread_id") @db.Uuid
  readerType  SupportPartyType @map("reader_type")
  readerId    String           @map("reader_id") @db.VarChar(128)
  lastReadAt  DateTime         @default(now()) @map("last_read_at")

  thread      SupportThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, readerType, readerId])
  @@index([readerType, readerId])
  @@map("support_read_receipts")
}
